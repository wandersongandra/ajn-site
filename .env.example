# Public build-time origin used for canonical, Open Graph, sitemap and robots.
PUBLIC_SITE_ORIGIN=https://ajnengenharia.com.br

# Staging/preview: false. Production cutover: true.
PUBLIC_ALLOW_INDEXING=false

# Public form provider endpoint. Leave unset until the production provider is approved.
PUBLIC_CONTACT_ENDPOINT=

# GA4 measurement ID (public, not a secret). Empty disables all GA4 network requests.
# Configure in Hostinger build environment, then rebuild/redeploy.
PUBLIC_GA4_MEASUREMENT_ID=G-N6L406K645

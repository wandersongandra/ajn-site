{
  "name": "astro-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-seo-files.mjs",
    "check": "astro check",
    "preview": "astro preview",
    "audit:seo": "node scripts/audit-seo.mjs",
    "validate": "npm run check && npm run build && npm run audit:seo",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.6"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}

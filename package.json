{
  "name": "astro-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:fragments": "node scripts/audit-fragments.mjs",
    "audit:deploy": "node scripts/audit-deploy.mjs",
    "audit:contact": "node scripts/audit-contact.mjs",
    "audit:sectors": "node scripts/audit-sectors.mjs",
    "audit:workflow": "node scripts/audit-workflow.mjs",
    "audit:hero": "node scripts/audit-hero.mjs",
    "audit:home-services": "node scripts/audit-home-services.mjs",
    "audit:footer": "node scripts/audit-footer.mjs",
    "test:audits": "node scripts/test-audit-fragments.mjs",
    "validate": "npm run check && npm run build && npm run audit:seo && npm run audit:fragments && npm run audit:deploy && npm run audit:contact && npm run audit:sectors && npm run audit:workflow && npm run audit:hero && npm run audit:home-services && npm run audit:footer && npm run test:audits"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.6",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}

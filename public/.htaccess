# Runtime hardening for Apache-compatible static hosting.
# Canonical domain: redirect www to HTTPS apex permanently after validating on production before merge.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.ajnengenharia\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^ https://ajnengenharia.com.br%{REQUEST_URI} [R=301,L,NE]
</IfModule>
# Redirecionamento permanente de Informações; ocorre no servidor antes do fallback Astro.
<IfModule mod_alias.c>
    # Compatibilidade com o sitemap legado; enviar crawlers ao índice atual.
    RedirectMatch 301 ^/sitemap\.xml/?$ https://ajnengenharia.com.br/sitemap-index.xml
    RedirectMatch 301 ^/informacoes/?$ /mapa-site

    # URLs editoriais do WordPress ainda rastreadas no Search Console (nov/2026).
    # Redirecionar apenas quando há conteúdo atual equivalente; páginas alheias
    # à atuação da AJN e arquivos de plugins antigos continuam retornando 404.
    RedirectMatch 301 ^/blog/avcb-o-que-voce-precisa-saber-sobre-o-auto-de-vistoria-do-corpo-de-bombeiros/?$ /blog/ppcip-avcb-clcb-como-organizar-a-regularizacao-do-imovel/
    RedirectMatch 301 ^/blog/ltcat-evento-esocial-o-que-voce-precisa-saber-para-estar-atualizado/?$ /ltcat-evento-esocial/
    RedirectMatch 301 ^/blog/sistemas-contra-incendio-bh-o-que-voce-precisa-saber/?$ /sistemas-incendio-bh/

    # Endereços legados de regularização AVCB com serviço equivalente ativo.
    RedirectMatch 301 ^/(regularizacao-avcb|avcb-auto-vistoria-do-corpo-bombeiros|renovacao-avcb-preco|renovacao-avcb|orcamento-avcb|avcb-custo|laudo-tecnico-avcb|avcb-orcamento|empresa-avcb)/?$ /servicos/regularizacao-de-imoveis-junto-ao-corpo-de-bombeiros/
</IfModule>
# Keep this file in the published output; verify the headers on the real host.
<IfModule mod_headers.c>
	Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https:; script-src 'self' https://www.googletagmanager.com; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google-analytics.com https://region1.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://api.opengscgandra.tech; media-src 'self'; worker-src 'self'; manifest-src 'self'"
	Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google-analytics.com https://region1.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://api.opengscgandra.tech; media-src 'self'; worker-src 'self'; manifest-src 'self'"
	Header always set Strict-Transport-Security "max-age=300"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), clipboard-read=(), clipboard-write=(), geolocation=(), microphone=(), payment=(), usb=()"
</IfModule>


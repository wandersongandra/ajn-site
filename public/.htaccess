# Runtime hardening for Apache-compatible static hosting.
# Canonical domain: the institutional Apache site remains authoritative for the
# corporate pages. Career pages are served by the Worker so their SSR status and
# canonical URL cannot be replaced by a static Apache fallback.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.ajnengenharia\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^ https://ajnengenharia.com.br%{REQUEST_URI} [R=301,L,NE]

    # O host legado da Hostinger não é um destino de staging válido. Falhar
    # fechado evita entregar a página estática ou enviar chamadas para produção.
    RewriteCond %{HTTP_HOST} ^sienna-mongoose-223157\.hostingersite\.com(?::[0-9]+)?$ [NC]
    RewriteRule ^(?:admin/)?carreiras(?:/.*)?$ - [R=410,L]

    # Produção: o domínio de carreiras será um Custom Domain do Worker.
    RewriteCond %{HTTP_HOST} ^ajnengenharia\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^admin/carreiras/?$ https://carreiras.ajnengenharia.com.br/admin/carreiras/ [R=301,L,NE]
    RewriteCond %{HTTP_HOST} ^ajnengenharia\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^admin/carreiras/(.*)$ https://carreiras.ajnengenharia.com.br/admin/carreiras/$1 [R=301,L,NE]
    RewriteCond %{HTTP_HOST} ^ajnengenharia\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^carreiras/?$ https://carreiras.ajnengenharia.com.br/carreiras/ [R=301,L,NE]
    RewriteCond %{HTTP_HOST} ^ajnengenharia\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^carreiras/(.*)$ https://carreiras.ajnengenharia.com.br/carreiras/$1 [R=301,L,NE]
</IfModule>
# Redirecionamento permanente de Informações; ocorre no servidor antes do fallback Astro.
<IfModule mod_alias.c>
    # Compatibilidade com o sitemap legado; enviar crawlers ao índice atual.
    RedirectMatch 301 ^/sitemap\.xml/?$ https://ajnengenharia.com.br/sitemap-index.xml
    RedirectMatch 301 ^/informacoes/?$ /mapa-site
</IfModule>
# Keep this file in the published output; verify the headers on the real host.
<IfModule mod_headers.c>
	Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://carreiras.ajnengenharia.com.br; script-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google-analytics.com https://region1.google-analytics.com; connect-src 'self' https://carreiras.ajnengenharia.com.br https://www.google-analytics.com https://region1.google-analytics.com https://challenges.cloudflare.com; media-src 'self'; worker-src 'self'; manifest-src 'self'"
	Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://carreiras.ajnengenharia.com.br; script-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google-analytics.com https://region1.google-analytics.com; connect-src 'self' https://carreiras.ajnengenharia.com.br https://www.google-analytics.com https://region1.google-analytics.com https://challenges.cloudflare.com; media-src 'self'; worker-src 'self'; manifest-src 'self'"
	Header always set Strict-Transport-Security "max-age=300"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), clipboard-read=(), clipboard-write=(), geolocation=(), microphone=(), payment=(), usb=()"
</IfModule>


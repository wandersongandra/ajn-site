# Runtime hardening for Apache-compatible hosting (Hostinger/LiteSpeed).
# O site institucional Astro permanece estático. Somente a API e as páginas
# dinâmicas de vagas são executadas pelo PHP da mesma hospedagem.
Options -Indexes

<FilesMatch "^\.(?!well-known)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.ajnengenharia\.com\.br(?::[0-9]+)?$ [NC]
    RewriteRule ^ https://ajnengenharia.com.br%{REQUEST_URI} [R=301,L,NE]

    # Bloqueia arquivos e diretórios ocultos (exceto validação ACME /.well-known).
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

    # API same-origin: o bootstrap privado falha fechado até configuração do
    # banco/segredos. Evita loop ao reescrever a própria entrada PHP.
    RewriteRule ^api/index\.php$ - [L]
    RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

    # Vagas individuais recebem status HTTP/SEO reais via PHP. Páginas
    # estáticas (talentos, acompanhamento e vaga) continuam com Astro.
    RewriteRule ^carreiras/(?!talentos/?$|acompanhamento/?$|vaga/?$)([a-z0-9-]+)/?$ api/index.php [QSA,L]
</IfModule>
# Redirecionamento permanente de Informações; ocorre no servidor antes do fallback Astro.
<IfModule mod_alias.c>
    # Compatibilidade com o sitemap legado; enviar crawlers ao índice atual.
    RedirectMatch 301 ^/sitemap\.xml/?$ https://ajnengenharia.com.br/sitemap-index.xml
    RedirectMatch 301 ^/informacoes/?$ /mapa-site

    # URLs editoriais do WordPress ainda rastreadas no Search Console (nov/2026).
    # Redirecionar apenas quando há conteúdo atual equivalente; páginas alheias
    # à atuação da AJN e arquivos de plugins antigos continuam retornando 404.
    RedirectMatch 301 ^/blog/avcb-o-que-voce-precisa-saber-sobre-o-auto-de-vistoria-do-corpo-de-bombeiros/?$ /blog/ppcip-avcb-clcb-como-organizar-a-regularizacao-do-imovel/
    RedirectMatch 301 ^/blog/ltcat-evento-esocial-o-que-voce-precisa-saber-para-estar-atualizado/?$ /ltcat-evento-esocial/
    RedirectMatch 301 ^/blog/sistemas-contra-incendio-bh-o-que-voce-precisa-saber/?$ /sistemas-incendio-bh/

    # Endereços legados de regularização AVCB com serviço equivalente ativo.
    RedirectMatch 301 ^/(regularizacao-avcb|avcb-auto-vistoria-do-corpo-bombeiros|renovacao-avcb-preco|renovacao-avcb|orcamento-avcb|avcb-custo|laudo-tecnico-avcb|avcb-orcamento|empresa-avcb)/?$ /servicos/regularizacao-de-imoveis-junto-ao-corpo-de-bombeiros/
</IfModule>
# O painel administrativo nao pode ficar em cache de navegador nem de proxy
# compartilhado. O HTML em si nao carrega dado, mas a pagina indica a existencia
# do painel e pode voltar pelo historico em estacao compartilhada.
# Usa SetEnvIf em vez de <If> porque a diretiva <If> depende de Apache 2.4 e o
# host roda LiteSpeed; se nao fosse reconhecida, derrubaria o site com HTTP 500.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/admin(/|$)" AJN_ADMIN_AREA=1
</IfModule>
# Keep this file in the published output; verify the headers on the real host.
<IfModule mod_headers.c>
	Header always set Cache-Control "no-store, max-age=0" env=AJN_ADMIN_AREA
	Header always set X-Robots-Tag "noindex, nofollow" env=AJN_ADMIN_AREA
	Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google-analytics.com https://region1.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://api.opengscgandra.tech https://challenges.cloudflare.com; media-src 'self'; worker-src 'self'; manifest-src 'self'"
	Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google-analytics.com https://region1.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://api.opengscgandra.tech https://challenges.cloudflare.com; media-src 'self'; worker-src 'self'; manifest-src 'self'"
	Header always set Strict-Transport-Security "max-age=300"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), clipboard-read=(), clipboard-write=(), geolocation=(), microphone=(), payment=(), usb=()"
</IfModule>


---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarketingDetailPage from '../components/MarketingDetailPage.astro';
import { marketingPages } from '../content/marketing';
import { getMarketingSeo } from '../utils/seo';

export function getStaticPaths() {
	return marketingPages.map((page) => ({
		params: { slug: page.slug },
		props: { page },
	}));
}

const { page } = Astro.props;
const seo = getMarketingSeo(page);
---

<BaseLayout title={seo.title} description={seo.description} canonicalPath={page.path} ogImage={page.images[0]?.src}>
	<MarketingDetailPage page={page} />
</BaseLayout>

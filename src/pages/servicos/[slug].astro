---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetailPage from '../../components/ServiceDetailPage.astro';
import { servicePages } from '../../content/services';
import type { ServiceContent } from '../../content/types';

interface Props {
	page: ServiceContent;
}

export const getStaticPaths: GetStaticPaths = () =>
	servicePages.map((page) => ({
		params: { slug: page.slug },
		props: { page },
	}));

const { page } = Astro.props;
// A rota antiga permanece acessível, mas não concorre com a landing principal de projetos elétricos.
const canonicalPath = page.slug === 'projetos-eletricos-residenciais-comerciais-e-prediais-com-foco-em-qualidade-prazo-e-economia'
  ? '/projetos-eletricos-prediais'
  : page.path;
---

<BaseLayout title={page.title} description={page.description} canonicalPath={canonicalPath}>
	<ServiceDetailPage page={page} />
</BaseLayout>

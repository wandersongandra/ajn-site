import HomeSectorsSection from '../components/HomeSectorsSection.astro';
import HomeContactCta from '../components/HomeContactCta.astro';
import SolutionsSection from '../components/SolutionsSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="AJN Consultoria e Engenharia | Segurança do Trabalho e Engenharia"
	description="Consultoria em segurança do trabalho, saúde ocupacional, eSocial, laudos técnicos, treinamentos e projetos de engenharia. Conheça os serviços da AJN."
>

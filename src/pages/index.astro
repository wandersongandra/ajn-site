---
import '../styles/home.css';
import '../styles/home-editorial.css';
import '../styles/home-motion.css';
import '../styles/clients-carousel.css';
import ClientsSection from '../components/ClientsSection.astro';
import InstagramHighlights from '../components/InstagramHighlights.astro';
import DifferentialsSection from '../components/DifferentialsSection.astro';
import Hero from '../components/Hero.astro';
import MedicoesHomeSection from '../components/MedicoesHomeSection.astro';
import HomeSectorsSection from '../components/HomeSectorsSection.astro';
import SolutionsSection from '../components/SolutionsSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Segurança do Trabalho, Laudos e Engenharia | AJN"
	description="Consultoria em segurança do trabalho, PGR, PCMSO, LTCAT, eSocial SST, treinamentos e projetos de engenharia. Conheça os serviços da AJN."
>
	<div class="home-page">
		<Hero />
		<SolutionsSection />
		<MedicoesHomeSection />
		<HomeSectorsSection />
		<ClientsSection />
		<InstagramHighlights />
		<DifferentialsSection />
	</div>
</BaseLayout>

<script src="/scripts/home.js" is:inline defer></script>

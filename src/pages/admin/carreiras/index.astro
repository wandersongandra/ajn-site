---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { serializeJsonLd } from '../../../utils/site';
import { careersOrigin } from '../../../utils/careers';
import '../../../styles/carreiras.css';

const title = 'Painel do Recrutador | AJN Carreiras';
const description = 'Área restrita da AJN para gestão de vagas, candidaturas, recrutadores e solicitações de dados pessoais.';
const canonicalPath = '/admin/carreiras/';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Painel do Recrutador — AJN Carreiras',
    description: 'Área interna para acompanhar vagas, candidaturas e banco de talentos.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  canonicalOrigin={careersOrigin}
  noindex={true}
>
  <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
  <div class="carreiras-page">
    <div class="site-shell">
      <header class="carreiras-header">
        <span class="carreiras-eyebrow">Acesso Restrito</span>
        <h1 class="carreiras-title">Painel de recrutamento da AJN</h1>
        <p class="carreiras-lead">
          Acompanhe candidaturas, organize as etapas das seleções e administre as vagas publicadas pela empresa.
        </p>
      </header>

      <!-- Cartão de Login Administrativo -->
      <div class="carreiras-form-container" data-admin-login-card style="max-width: 480px; margin-inline: auto;">
        <h2 style="font-family: var(--font-display); font-size: 1.375rem; color: var(--ink); margin-bottom: 0.5rem; text-align: center;">
          Entrar na área de recrutamento
        </h2>
        <p style="font-size: 0.875rem; color: var(--text-soft); margin-bottom: 1.5rem; text-align: center;">
          Entre com seu e-mail corporativo e senha. O código de autenticação será solicitado quando necessário.
        </p>

        <div class="carreiras-notice" data-login-notice role="alert"></div>

        <form data-admin-login-form>
          <div class="carreiras-field" style="margin-bottom: 1.25rem;">
            <label class="carreiras-label" for="admin-email">E-mail corporativo</label>
            <input class="carreiras-input" id="admin-email" name="email" type="email" required autocomplete="username" placeholder="nome@ajnengenharia.com.br" />
          </div>

          <div class="carreiras-field" style="margin-bottom: 1.25rem;">
            <label class="carreiras-label" for="admin-password">Senha de acesso</label>
            <input class="carreiras-input" id="admin-password" name="password" type="password" required minlength="8" autocomplete="current-password" placeholder="Sua senha" />
          </div>

          <div class="carreiras-field" data-mfa-field style="display: none; margin-bottom: 1.25rem;">
            <label class="carreiras-label" for="admin-mfa">Código do aplicativo autenticador</label>
            <input class="carreiras-input" id="admin-mfa" name="mfaCode" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" style="text-align: center; letter-spacing: 0.2em; font-family: monospace;" />
          </div>

          <button class="carreiras-button carreiras-button--primary" style="width: 100%; margin-top: 0.5rem;" type="submit">
            Entrar no painel
          </button>

          <div style="margin-top: 1rem; text-align: center;">
            <button class="carreiras-link-button" data-show-forgot-btn type="button" style="background: none; border: none; color: var(--brand-action, #166534); cursor: pointer; text-decoration: underline; font-size: 0.875rem;">
              Esqueceu sua senha de acesso?
            </button>
          </div>
        </form>

        <!-- Formulário de Solicitação de Redefinição de Senha -->
        <form data-admin-forgot-form style="display: none;">
          <div class="carreiras-field" style="margin-bottom: 1.25rem;">
            <label class="carreiras-label" for="admin-forgot-email">E-mail corporativo</label>
            <input class="carreiras-input" id="admin-forgot-email" name="forgotEmail" type="email" required placeholder="nome@ajnengenharia.com.br" />
          </div>

          <button class="carreiras-button carreiras-button--primary" style="width: 100%; margin-top: 0.5rem;" type="submit">
            Enviar instruções por e-mail
          </button>

          <div style="margin-top: 1rem; text-align: center;">
            <button class="carreiras-link-button" data-show-login-btn type="button" style="background: none; border: none; color: var(--text-soft); cursor: pointer; text-decoration: underline; font-size: 0.875rem;">
              ← Voltar para o formulário de login
            </button>
          </div>
        </form>
      </div>

      <!-- Cartão de Redefinição com Token (Ativado via ?resetToken=...) -->
      <div class="carreiras-form-container" data-admin-reset-card style="display: none; max-width: 480px; margin-inline: auto;">
        <h2 style="font-family: var(--font-display); font-size: 1.375rem; color: var(--ink); margin-bottom: 0.5rem; text-align: center;">
          Redefinir senha
        </h2>
        <p style="font-size: 0.875rem; color: var(--text-soft); margin-bottom: 1.5rem; text-align: center;">
          Crie uma nova senha segura para restaurar seu acesso administrativo.
        </p>

        <div class="carreiras-notice" data-reset-notice role="alert"></div>

        <form data-admin-reset-form>
          <div class="carreiras-field" style="margin-bottom: 1.25rem;">
            <label class="carreiras-label" for="admin-new-password">Nova senha (mínimo de 16 caracteres)</label>
            <input class="carreiras-input" id="admin-new-password" name="newPassword" type="password" required minlength="16" placeholder="••••••••••••" />
          </div>

          <div class="carreiras-field" style="margin-bottom: 1.25rem;">
            <label class="carreiras-label" for="admin-confirm-password">Confirmar nova senha</label>
            <input class="carreiras-input" id="admin-confirm-password" name="confirmPassword" type="password" required minlength="16" placeholder="••••••••••••" />
          </div>

          <button class="carreiras-button carreiras-button--primary" style="width: 100%; margin-top: 0.5rem;" type="submit">
            Salvar nova senha
          </button>
        </form>
      </div>

      <!-- Dashboard do Recrutador (Exibido após login) -->
      <div data-admin-dashboard style="display: none;">
        <div class="admin-header">
          <div>
            <h2 style="font-family: var(--font-display); font-size: 1.5rem; color: var(--ink); margin-bottom: 0.25rem;">
              Olá, <span data-admin-user-name>recrutador</span>
            </h2>
            <div style="font-size: 0.875rem; color: var(--text-soft);">
              Perfil ativo: <span class="carreiras-badge carreiras-badge--primary" data-admin-user-role>recruiter</span>
            </div>
          </div>

          <div style="display: flex; gap: 0.75rem;">
            <a class="carreiras-button carreiras-button--secondary" href="/carreiras/" target="_blank" rel="noopener noreferrer">
              Ver portal de vagas
            </a>
            <button class="carreiras-button carreiras-button--secondary" data-admin-logout type="button">
              Sair
            </button>
          </div>
        </div>

        <!-- Abas do Dashboard -->
        <div class="carreiras-nav-bar" style="justify-content: flex-start; margin-bottom: 2rem;">
          <button class="carreiras-nav-link" data-admin-tab="pipeline" aria-selected="true" type="button">
            Etapas de seleção
          </button>
          <button class="carreiras-nav-link" data-admin-tab="candidates" aria-selected="false" type="button">
            Candidatos e currículos
          </button>
          <button class="carreiras-nav-link" data-admin-tab="jobs" aria-selected="false" type="button">
            Vagas e publicações
          </button>
          <button class="carreiras-nav-link" data-admin-tab="lgpd" aria-selected="false" type="button">
            Solicitações LGPD
          </button>
          <button class="carreiras-nav-link" data-admin-tab="audit" aria-selected="false" type="button">
            Histórico de ações
          </button>
          <button class="carreiras-nav-link" data-admin-tab="users" aria-selected="false" type="button" data-admin-users-tab style="display: none;">
            Equipe de recrutamento
          </button>
        </div>

        <!-- Painel 1: Pipeline & Kanban -->
        <div data-admin-pane="pipeline">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 1rem;">
              <label for="pipeline-select" style="font-weight: 600; font-size: 0.9375rem; color: var(--ink);">
                Selecione uma vaga:
              </label>
              <select class="carreiras-select" id="pipeline-select" data-pipeline-job-select style="max-width: 380px;">
                <option value="">Carregando vagas…</option>
              </select>
            </div>
            <div style="font-size: 0.8125rem; color: var(--text-soft);">
              A avaliação de candidatos é feita pela equipe de recrutamento.
            </div>
          </div>

          <div class="pipeline-board" data-pipeline-board>
            <!-- Colunas do Kanban renderizadas via JavaScript seguro -->
          </div>
          <div class="carreiras-notice" data-pipeline-notice role="status" aria-live="polite"></div>

          <dialog class="carreiras-stage-dialog" data-move-stage-dialog aria-labelledby="move-stage-title" aria-describedby="move-stage-description">
            <form data-move-stage-form>
              <div class="carreiras-stage-dialog__heading">
                <span class="carreiras-eyebrow">Avaliação humana</span>
                <h3 id="move-stage-title">Movimentar candidatura</h3>
                <p id="move-stage-description" data-move-stage-candidate>Selecione a próxima etapa do processo seletivo.</p>
              </div>
              <div class="carreiras-field">
                <label class="carreiras-label" for="move-stage-target">Nova etapa *</label>
                <select class="carreiras-select" id="move-stage-target" name="targetStageId" required>
                  <option value="">Selecione uma etapa</option>
                </select>
              </div>
              <div class="carreiras-field">
                <label class="carreiras-label" for="move-stage-notes">Observações do recrutador (opcional)</label>
                <textarea class="carreiras-textarea" id="move-stage-notes" name="notes" maxlength="4000" rows="3" placeholder="Registre apenas informações relevantes para a seleção."></textarea>
              </div>
              <div class="carreiras-field">
                <label class="carreiras-label" for="move-stage-rating">Avaliação humana (opcional)</label>
                <select class="carreiras-select" id="move-stage-rating" name="rating">
                  <option value="">Sem avaliação</option>
                  <option value="1">1 estrela</option>
                  <option value="2">2 estrelas</option>
                  <option value="3">3 estrelas</option>
                  <option value="4">4 estrelas</option>
                  <option value="5">5 estrelas</option>
                </select>
              </div>
              <div class="carreiras-notice" data-move-stage-notice role="alert" aria-live="assertive"></div>
              <div class="carreiras-stage-dialog__actions">
                <button class="carreiras-button carreiras-button--secondary" data-cancel-move-stage type="button">Cancelar</button>
                <button class="carreiras-button carreiras-button--primary" data-submit-move-stage type="submit">Confirmar movimentação</button>
              </div>
            </form>
          </dialog>
        </div>

        <!-- Painel 2: Candidatos & Currículos -->
        <div data-admin-pane="candidates" style="display: none;">
          <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin-bottom: 1rem; color: var(--ink);">
            Candidatos e banco de talentos
          </h3>
          <div class="admin-table-container">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Nome do candidato</th>
                  <th>Contato (e-mail / telefone)</th>
                  <th>Localização</th>
                  <th>Cargo / formação</th>
                  <th>Ações e currículo</th>
                </tr>
              </thead>
              <tbody data-candidates-tbody>
                <!-- Preenchido via script -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Painel 3: Vagas Cadastradas -->
        <div data-admin-pane="jobs" style="display: none;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
            <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin: 0; color: var(--ink);">
              Vagas cadastradas
            </h3>
            <button class="carreiras-button carreiras-button--primary" data-toggle-job-form type="button">
              + Cadastrar ou editar vaga
            </button>
          </div>
          <div class="carreiras-notice" data-jobs-notice role="alert"></div>
          <div class="carreiras-form-container" data-job-form-card style="display: none; max-width: 760px; margin-bottom: 2rem;">
            <h4 style="font-size: 1.125rem; margin-top: 0; margin-bottom: 1rem; color: var(--ink);" data-job-form-title>Nova vaga</h4>
            <form data-job-form>
              <input type="hidden" name="jobId" />
              <div class="carreiras-form-grid">
                <div class="carreiras-field carreiras-form-full">
                  <label class="carreiras-label" for="admin-job-title">Título *</label>
                  <input class="carreiras-input" id="admin-job-title" name="title" required minlength="3" maxlength="150" />
                </div>
                <div class="carreiras-field">
                  <label class="carreiras-label" for="admin-job-slug">Slug *</label>
                  <input class="carreiras-input" id="admin-job-slug" name="slug" required minlength="3" pattern="[a-z0-9-]+" placeholder="engenheiro-seguranca" />
                </div>
                <div class="carreiras-field">
                  <label class="carreiras-label" for="admin-job-department">Departamento *</label>
                  <input class="carreiras-input" id="admin-job-department" name="department" required minlength="2" />
                </div>
                <div class="carreiras-field">
                  <label class="carreiras-label" for="admin-job-location">Local *</label>
                  <input class="carreiras-input" id="admin-job-location" name="location" required minlength="2" />
                </div>
                <div class="carreiras-field">
                  <label class="carreiras-label" for="admin-job-type">Regime *</label>
                  <select class="carreiras-select" id="admin-job-type" name="employmentType" required>
                    <option value="CLT">CLT</option>
                    <option value="PJ">PJ</option>
                    <option value="Estágio">Estágio</option>
                    <option value="Temporário">Temporário</option>
                  </select>
                </div>
                <div class="carreiras-field">
                  <label class="carreiras-label" for="admin-job-level">Experiência *</label>
                  <select class="carreiras-select" id="admin-job-level" name="experienceLevel" required>
                    <option value="Júnior">Júnior</option>
                    <option value="Pleno">Pleno</option>
                    <option value="Sênior">Sênior</option>
                    <option value="Especialista">Especialista</option>
                  </select>
                </div>
                <div class="carreiras-field">
                  <label class="carreiras-label" for="admin-job-status">Status *</label>
                  <select class="carreiras-select" id="admin-job-status" name="status" required>
                    <option value="draft">Rascunho</option>
                    <option value="published">Publicada</option>
                    <option value="paused">Pausada</option>
                    <option value="closed">Encerrada</option>
                    <option value="archived">Arquivada</option>
                  </select>
                </div>
                <div class="carreiras-field">
                  <label class="carreiras-label" for="admin-job-openings">Número de vagas *</label>
                  <input class="carreiras-input" id="admin-job-openings" name="openingsCount" type="number" min="1" step="1" value="1" required />
                </div>
                <div class="carreiras-field carreiras-form-full">
                  <label class="carreiras-label" for="admin-job-description">Descrição *</label>
                  <textarea class="carreiras-textarea" id="admin-job-description" name="description" required minlength="20" rows="5"></textarea>
                </div>
                <div class="carreiras-field carreiras-form-full">
                  <label class="carreiras-label" for="admin-job-requirements">Requisitos (um por linha) *</label>
                  <textarea class="carreiras-textarea" id="admin-job-requirements" name="requirements" required rows="4"></textarea>
                </div>
                <div class="carreiras-form-full" style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                  <button class="carreiras-button carreiras-button--primary" type="submit" data-job-form-submit>Salvar vaga</button>
                  <button class="carreiras-button carreiras-button--secondary" data-cancel-job-form type="button">Cancelar</button>
                </div>
              </div>
            </form>
          </div>
          <div class="admin-table-container">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Título da vaga</th>
                  <th>Departamento</th>
                  <th>Local</th>
                  <th>Regime</th>
                  <th>Status</th>
                  <th>Candidatos</th>
                  <th>Ações</th>
                </tr>
              </thead>
              <tbody data-jobs-tbody>
                <!-- Preenchido via script -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Painel 4: Gestão LGPD -->
        <div data-admin-pane="lgpd" style="display: none;">
          <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin-bottom: 1rem; color: var(--ink);">
            Solicitações de titulares de dados
          </h3>
          <p style="font-size: 0.875rem; color: var(--text-soft); margin-bottom: 1rem;">
            Confira os dados e o fundamento de cada solicitação antes de executar uma exclusão. A remoção de currículos pode ser irreversível.
          </p>
          <div class="carreiras-notice" data-lgpd-notice role="status" aria-live="polite"></div>
          <div class="admin-table-container">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Tipo de solicitação</th>
                  <th>Titular</th>
                  <th>Data do pedido</th>
                  <th>Status</th>
                  <th>Ação do responsável</th>
                </tr>
              </thead>
              <tbody data-lgpd-tbody>
                <!-- Preenchido via script -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Painel 5: Trilha de Auditoria -->
        <div data-admin-pane="audit" style="display: none;">
          <h3 style="font-family: var(--font-display); font-size: 1.25rem; margin-bottom: 1rem; color: var(--ink);">
            Histórico de ações administrativas
          </h3>
          <div class="admin-table-container">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Data e hora</th>
                  <th>Ação realizada</th>
                  <th>Ator</th>
                  <th>Recurso</th>
                  <th>Endereço IP</th>
                </tr>
              </thead>
              <tbody data-audit-tbody>
                <!-- Preenchido via script -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Painel 6: Gestão de Contas de Recrutadores (Apenas Administradores) -->
        <div data-admin-pane="users" style="display: none;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
            <h3 style="font-family: var(--font-display); font-size: 1.25rem; color: var(--ink); margin: 0;">
              Equipe de recrutamento e permissões
            </h3>
            <button class="carreiras-button carreiras-button--primary" data-toggle-create-user-btn type="button">
              + Cadastrar recrutador
            </button>
          </div>

          <div class="carreiras-notice" data-users-notice role="alert"></div>

          <!-- Formulário de Criação de Usuário (Oculto por padrão) -->
          <div class="carreiras-form-container" data-create-user-card style="display: none; max-width: 600px; margin-bottom: 2rem;">
            <h4 style="font-size: 1.125rem; margin-top: 0; margin-bottom: 1rem; color: var(--ink);">Novo acesso administrativo</h4>
            <form data-create-user-form>
              <div class="carreiras-form-grid">
                <div class="carreiras-field">
                  <label class="carreiras-label" for="new-user-name">Nome completo *</label>
                  <input class="carreiras-input" id="new-user-name" name="name" type="text" required placeholder="Ex: Ana Souza" />
                </div>
                <div class="carreiras-field">
                  <label class="carreiras-label" for="new-user-email">E-mail corporativo *</label>
                  <input class="carreiras-input" id="new-user-email" name="email" type="email" required placeholder="ana@ajnengenharia.com.br" />
                </div>
                <div class="carreiras-field">
                  <label class="carreiras-label" for="new-user-role">Perfil de acesso *</label>
                  <select class="carreiras-select" id="new-user-role" name="role" required>
                    <option value="recruiter">Recrutador</option>
                    <option value="viewer">Somente leitura</option>
                    <option value="dpo">Responsável pela privacidade</option>
                    <option value="super_admin">Administrador geral</option>
                  </select>
                </div>
                <div class="carreiras-field">
                  <label class="carreiras-label" for="new-user-password">Senha provisória *</label>
                  <input class="carreiras-input" id="new-user-password" name="password" type="password" required minlength="12" placeholder="••••••••••••" />
                </div>
                <div class="carreiras-form-full" style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                  <button class="carreiras-button carreiras-button--primary" type="submit">Salvar usuário</button>
                  <button class="carreiras-button carreiras-button--secondary" data-cancel-create-user type="button">Cancelar</button>
                </div>
              </div>
            </form>
          </div>

          <div class="admin-table-container">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Nome</th>
                  <th>E-mail</th>
                  <th>Função</th>
                  <th>MFA</th>
                  <th>Status</th>
                  <th>Ações</th>
                </tr>
              </thead>
              <tbody data-users-tbody>
                <!-- Preenchido via script -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/scripts/admin-carreiras.js?v=20261110-consent-gate" defer></script>
</BaseLayout>

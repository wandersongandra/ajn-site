---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PromoDialog from '../components/PromoDialog.astro';
import SocialFloat from '../components/SocialFloat.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	ogType?: 'website' | 'article';
	ogImage?: string;
}

const {
	title = 'Serviços de Engenharia de Segurança do Trabalho - AJN Consultoria e Engenharia',
	description = 'A AJN Consultoria e Engenharia oferece soluções em qualidade, saúde, segurança, meio ambiente e engenharia.',
	canonicalPath = '/',
	ogType = 'website',
	ogImage,
} = Astro.props;

const siteOrigin = import.meta.env.PUBLIC_SITE_ORIGIN ?? 'https://www.ajnengenharia.com.br';
const canonicalUrl = `${siteOrigin}${canonicalPath === '/' ? '/' : canonicalPath}`;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		{ogImage ? <meta property="og:image" content={`${siteOrigin}${ogImage}`} /> : null}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="icon" type="image/webp" href="/images/icons/logo-icon.webp" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<main><slot /></main>
		<Footer />
		<SocialFloat />
		<CookieBanner />
		{Astro.url.pathname === '/' ? <PromoDialog /> : null}
	</body>
</html>

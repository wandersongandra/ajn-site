---
import '../styles/blog.css';
import { Image } from 'astro:assets';
import ContentSections from '../components/ContentSections.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import { blogPosts, getRelatedBlogPosts } from '../content/blog/catalog';
import type { BlogContentData } from '../content.config';
import { absoluteSiteUrl, serializeJsonLd } from '../utils/site';

interface Props {
	post: BlogContentData;
}

const { post } = Astro.props;
const formattedDate = post.pubDate.toLocaleDateString('pt-BR', {
	day: '2-digit',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});
const formattedUpdated = post.updatedAt?.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.heading,
	description: post.description,
	datePublished: post.pubDate.toISOString(),
	dateModified: (post.updatedAt ?? post.pubDate).toISOString(),
	author: post.author === 'Admin' || post.author === 'AJN Consultoria e Engenharia'
		? { '@type': 'Organization', name: 'AJN Consultoria e Engenharia' }
		: { '@type': 'Person', name: post.author },
	publisher: {
		'@type': 'Organization',
		name: 'AJN Consultoria e Engenharia',
		logo: { '@type': 'ImageObject', url: absoluteSiteUrl('/images/branding/logo.png') },
	},
	mainEntityOfPage: absoluteSiteUrl(post.path),
	image: [absoluteSiteUrl('/images/og/' + post.slug + '.jpg')],
	inLanguage: 'pt-BR',
};

const toc = post.sections.map((section, index) => ({
	title: section.heading.trim(),
	id: 'blog-secao-' + (index + 1),
})).filter((entry) => entry.title.length > 0);
const self = blogPosts.find((item) => item.href === post.path);
const related = getRelatedBlogPosts(post.path);

// Relaciona artigos aos serviços publicados sem alterar as URLs legadas.
const servicesByTopic: Record<string, readonly { title: string; href: string }[]> = {
  'LTCAT': [
    { title: 'Elaboração de LTCAT', href: '/emissao-ltcat' },
    { title: 'LTCAT e insalubridade: diferenças', href: '/laudo-ltcat-insalubridade' },
  ],
  'PGR e riscos': [
    { title: 'Elaboração de PGR', href: '/elaboracao-pgr' },
    { title: 'Consultoria em segurança do trabalho', href: '/consultoria-seguranca-do-trabalho' },
  ],
  'PCMSO': [
    { title: 'Gestão de PCMSO e ASOs', href: '/servicos/pcmso-e-asos' },
  ],
  'PPP e eSocial': [
    { title: 'Gestão de SST no eSocial', href: '/servicos/gestao-do-e-social' },
    { title: 'Elaboração de LTCAT', href: '/emissao-ltcat' },
  ],
  'Normas regulamentadoras': [
    { title: 'Treinamentos de NRs', href: '/servicos/treinamento-de-nrs' },
  ],
};
const relatedServices = servicesByTopic[self?.topic ?? ''] ?? [];


// Exibe fotos complementares sem repetir a capa ou a mesma foto mais de uma vez.
const galleryImages = post.gallery.filter((image, index, images) =>
	image.src.src !== post.image.src.src
	&& images.findIndex((entry) => entry.src.src === image.src.src) === index
);
const galleryPreview = galleryImages.slice(0, 3);
const galleryRemaining = galleryImages.slice(3);

---

<section class="inner-page blog-reading">
	<div class="site-shell">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			<a href="/blog">Blog</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{post.heading}</span>
		</nav>
		<div class="blog-article-layout">
			<article class="blog-article reading-surface">
				<header class="blog-article__header">
					<p class="blog-article__kicker">Blog AJN {self ? ' · ' + self.topic : ''}</p>
					<h1 class="page-title">{post.heading}</h1>
					<p class="blog-article__description">{post.description}</p>
					<p class="blog-article__meta">
						<span>Publicado em </span>
						<time datetime={post.pubDate.toISOString()}>{formattedDate}</time>
						{post.author === 'Admin'
              ? <span> · Por <a href="/sobre-nos">AJN Consultoria e Engenharia</a></span>
              : <span> · Por {post.author}</span>}
						{post.updatedAt && <span> · Atualizado em <time datetime={post.updatedAt.toISOString()}>{formattedUpdated}</time></span>}
					</p>
				</header>

				<Image
					class="blog-article__image"
					src={post.image.src}
					alt={post.image.alt}
					width={880}
					widths={[480, 720, 880, 1100]}
					sizes="(max-width: 800px) calc(100vw - 32px), (max-width: 1100px) 70vw, 760px"
					format="webp"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>

				{toc.length > 1 ? (
					<nav class="blog-article__toc" aria-label="Nesta publicação">
						<h2>Neste artigo</h2>
						<ol>{toc.map((entry) => <li><a href={'#' + entry.id}>{entry.title}</a></li>)}</ol>
					</nav>
				) : null}

				<div class="blog-article__content">
					{post.sections.map((section, index) => (
						<div id={'blog-secao-' + (index + 1)} class="blog-article__section">
							<ContentSections sections={[section]} />
						</div>
					))}
				</div>

				{relatedServices.length > 0 && (
					<nav class="blog-article__service-links" aria-label="Serviços relacionados a este artigo">
						<p class="blog-article__service-links-heading">Precisa de apoio com esse assunto?</p>
						<ul>{relatedServices.map((service) => (
							<li><a href={service.href}>{service.title}<span aria-hidden="true"> →</span></a></li>
						))}</ul>
					</nav>
				)}

				{galleryImages.length > 0 && (
					<section class="blog-article__gallery-section" aria-labelledby="article-gallery-title">
						<h2 id="article-gallery-title">Imagens relacionadas</h2>
						<div class="blog-article__gallery" aria-label="Galeria do artigo">
							{galleryPreview.map((image) => (
								<Image src={image.src} alt={image.alt} width={440} widths={[240, 320, 440, 600]} sizes="(max-width: 620px) 45vw, (max-width: 900px) 30vw, 200px" format="webp" loading="lazy" decoding="async" />
							))}
						</div>
						{galleryRemaining.length > 0 && (
							<details class="blog-article__gallery-more">
								<summary>Ver mais {galleryRemaining.length} imagens</summary>
								<div class="blog-article__gallery">
									{galleryRemaining.map((image) => (
										<Image src={image.src} alt={image.alt} width={440} widths={[240, 320, 440, 600]} sizes="(max-width: 620px) 45vw, (max-width: 900px) 30vw, 200px" format="webp" loading="lazy" decoding="async" />
									))}
								</div>
							</details>
						)}
					</section>
				)}

				<footer class="blog-article__footer">
					{self && (
						<a class="blog-article__topic" href={'/blog?tema=' + encodeURIComponent(self.topic)}>
							Mais artigos sobre {self.topic} <span aria-hidden="true">→</span>
						</a>
					)}
					<div class="blog-article__actions">
						<a href="/blog">← Voltar para o blog</a>
						<a href="/contato">Falar com a AJN →</a>
					</div>
				</footer>
			</article>
			<BlogSidebar context="article" currentPath={post.path} />
		</div>

		{related.length > 0 && (
			<section class="blog-related" aria-labelledby="blog-related-heading">
				<div class="blog-related__heading">
					<div>
						<p>Continue a leitura</p>
						<h2 id="blog-related-heading">Artigos do mesmo assunto</h2>
					</div>
					<a href="/blog">Ver blog completo →</a>
				</div>
				<div class="blog-related__grid">
					{related.map((item) => (
						<article class="blog-related__card">
							<a href={item.href} class="blog-related__media" aria-label={'Ler: ' + item.title}>
								<Image src={item.image} alt={item.alt} width={440} widths={[240, 360, 440, 640]} sizes="(max-width: 620px) calc(100vw - 32px), (max-width: 900px) 45vw, 300px" format="webp" loading="lazy" decoding="async" />
							</a>
							<div>
								<p>{item.topic}</p>
								<h3><a href={item.href}>{item.title}</a></h3>
							</div>
						</article>
					))}
				</div>
			</section>
		)}
	</div>
	<script type="application/ld+json" set:html={serializeJsonLd(articleSchema)} />
</section>

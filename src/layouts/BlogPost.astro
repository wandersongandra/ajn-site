---
import '../styles/blog.css';
import { Image } from 'astro:assets';
import ContentSections from '../components/ContentSections.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import { blogPosts, getRelatedBlogPosts } from '../content/blog/catalog';
import type { BlogContentData } from '../content.config';
import { absoluteSiteUrl, serializeJsonLd, siteOrigin } from '../utils/site';

interface Props {
	post: BlogContentData;
}

const { post } = Astro.props;
const formattedDate = post.pubDate.toLocaleDateString('pt-BR', {
	day: '2-digit',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});
const formattedUpdated = post.updatedAt?.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.heading,
	description: post.description,
	datePublished: post.pubDate.toISOString(),
	dateModified: (post.updatedAt ?? post.pubDate).toISOString(),
	author: post.author === 'Admin' || post.author === 'AJN Consultoria e Engenharia'
		? { '@type': 'Organization', '@id': `${siteOrigin}/#organization`, name: 'AJN Consultoria e Engenharia', logo: { '@type': 'ImageObject', url: absoluteSiteUrl('/images/branding/logo.png') } }
		: { '@type': 'Person', name: post.author },
	publisher: {
		'@type': 'Organization',
		'@id': `${siteOrigin}/#organization`,
		name: 'AJN Consultoria e Engenharia',
		logo: { '@type': 'ImageObject', url: absoluteSiteUrl('/images/branding/logo.png') },
	},
	mainEntityOfPage: absoluteSiteUrl(`${post.path}/`),
	image: [absoluteSiteUrl('/images/og/' + post.slug + '.jpg')],
	inLanguage: 'pt-BR',
};

const toc = post.sections.map((section, index) => ({
	title: section.heading.trim(),
	id: 'blog-secao-' + (index + 1),
})).filter((entry) => entry.title.length > 0);
const self = blogPosts.find((item) => item.href === post.path);
const related = getRelatedBlogPosts(post.path);

// Links só aparecem quando há uma página de serviço existente e compatível.
const relatedServicesBySlug: Record<string, readonly { title: string; href: string }[]> = {
  'laudo-tecnico-das-condicoes-ambientais-de-trabalho-ltcat': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'ltcat-papel-fundamental-na-seguranca-do-trabalho-e-no-bem-estar-dos-colaboradores': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'orcamento-eficiente-para-ltcat-passos-essenciais-para-garantir-a-seguranca-no-trabalho': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'ltcat-e-seguranca-do-trabalho-como-garantir-a-protecao-eficaz-da-sua-equipe': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'ltcat-e-seguranca-do-trabalho-como-proteger-sua-empresa-com-eficiencia': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'ltcat-guia-essencial-para-garantir-a-seguranca-no-ambiente-de-trabalho': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'ltcat-na-seguranca-do-trabalho-fortaleca-a-protecao-dos-seus-funcionarios-eficazmente': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'seguranca-do-trabalho-e-ltcat-conformidade-e-protecao-previdenciaria': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'ltcat-guia-essencial-para-garantir-seguranca-do-trabalho-eficaz': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'ltcat-essencial-para-a-seguranca-do-trabalho-e-protecao-da-sua-equipe': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'ltcat-na-seguranca-do-trabalho-garantindo-protecao-e-reducao-de-riscos-para-sua-equipe': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'a-importancia-do-ltcat-para-a-seguranca-do-trabalho-e-a-protecao-do-ambiente-profissional': [{ title: 'Elaboração de LTCAT', href: '/emissao-ltcat' }],
  'o-fim-do-ppra-e-a-chegada-do-pgr-o-que-mudou': [{ title: 'Elaboração de PGR', href: '/elaboracao-pgr' }],
  'laudo-de-gerenciamento-de-riscos-essencial-para-garantir-a-seguranca-no-ambiente-de-trabalho': [{ title: 'Elaboração de PGR', href: '/elaboracao-pgr' }],
  'elaboracao-de-pgr-e-pcmso-conformidade-e-seguranca-no-trabalho': [{ title: 'Elaboração de PGR', href: '/elaboracao-pgr' }, { title: 'Gestão de PCMSO e ASOs', href: '/servicos/pcmso-e-asos' }],
  'seguranca-do-trabalho-e-pcmso-gestao-da-saude-ocupacional': [{ title: 'Gestão de PCMSO e ASOs', href: '/servicos/pcmso-e-asos' }],
  'ppp-facil-o-ue-e-como-consultar-e-sua-importancia': [{ title: 'Gestão de SST no eSocial', href: '/servicos/gestao-do-e-social' }],
  'perfil-profissiografico-previdenciario-ppp': [{ title: 'Gestão de SST no eSocial', href: '/servicos/gestao-do-e-social' }],
  'nr-35-trabalho-em-altura-e-seguranca': [{ title: 'Treinamentos de NRs', href: '/servicos/treinamento-de-nrs' }],
  'gestao-de-terceiros-em-sst-documentos-mobilizacao-e-controles': [{ title: 'Consultoria em segurança do trabalho', href: '/consultoria-seguranca-do-trabalho' }],
  'esocial-sst-diferencas-entre-s2210-s2220-e-s2240': [{ title: 'Gestão de SST no eSocial', href: '/servicos/gestao-do-e-social' }],
  'apr-e-permissao-de-trabalho-como-planejar-atividades-de-risco': [{ title: 'Consultoria em segurança do trabalho', href: '/consultoria-seguranca-do-trabalho' }],
  'nr-10-documentacao-capacitacao-e-transicao-regulatoria': [{ title: 'Treinamentos de NRs', href: '/servicos/treinamento-de-nrs' }],
  'higiene-ocupacional-como-planejar-avaliacoes-de-exposicao': [{ title: 'Perícias de insalubridade e periculosidade', href: '/servicos/pericias-em-periculosidade-e-insalubridade' }],
  'investigacao-de-acidentes-como-transformar-registros-em-prevencao': [{ title: 'Inspeções de segurança do trabalho', href: '/inspecoes-seguranca-do-trabalho' }],
  'gestao-de-residuos-como-organizar-a-rotina-da-operacao': [{ title: 'Gestão ambiental', href: '/servicos/gestao-ambiental' }],
  'controle-de-qualidade-em-obras-registros-inspecoes-e-desvios': [{ title: 'Gestão da qualidade', href: '/servicos/gestao-da-qualidade' }],
  'ppcip-avcb-clcb-como-organizar-a-regularizacao-do-imovel': [
    { title: 'Projetos de combate a incêndio e pânico (PPCIP)', href: '/servicos/projetos-de-combate-a-incendio-e-panico-ppcip' },
    { title: 'Regularização de imóveis junto ao Corpo de Bombeiros', href: '/servicos/regularizacao-de-imoveis-junto-ao-corpo-de-bombeiros' },
  ],
};
const relatedServices = relatedServicesBySlug[post.slug] ?? [];
const contextualCta: Record<string, string> = {
  'Gestão de SST': 'Precisa coordenar riscos, documentos e rotinas de prevenção? Converse com a AJN sobre o escopo adequado à operação da sua empresa.',
  'Saúde ocupacional': 'Quer organizar a rotina de saúde ocupacional e seus registros? Converse com a AJN sobre as necessidades da sua empresa.',
  'Laudos e avaliações técnicas': 'Precisa avaliar documentos ou exposições ocupacionais? A equipe da AJN pode conversar sobre o escopo técnico aplicável.',
  'Normas regulamentadoras': 'Precisa avaliar capacitação ou controles relacionados a uma NR? Converse com a AJN sobre a atividade e os requisitos envolvidos.',
  'eSocial e obrigações': 'Precisa revisar a organização dos registros de SST enviados ao eSocial? Converse com a AJN sobre a sua rotina documental.',
  'Segurança operacional': 'Quer estruturar uma atividade ou rotina preventiva? Converse com a AJN sobre o cenário e os controles necessários.',
  'Institucional': 'Se quiser conhecer as frentes de atendimento da AJN, fale com a equipe pelo canal de contato.',
  'Gestão ambiental e qualidade': 'Precisa organizar requisitos ambientais ou de qualidade em uma operação ou obra? Converse com a AJN sobre o escopo aplicável.',
  'Engenharia e prevenção contra incêndio': 'Precisa analisar um projeto ou a situação documental de uma edificação? Converse com a AJN sobre os próximos passos possíveis.',
};
const ctaDescription = contextualCta[self?.topic ?? ''] ?? 'Converse com a equipe da AJN sobre as necessidades de SST da sua empresa.';


// Exibe fotos complementares sem repetir a capa ou a mesma foto mais de uma vez.
const galleryImages = post.gallery.filter((image, index, images) =>
	image.src.src !== post.image.src.src
	&& images.findIndex((entry) => entry.src.src === image.src.src) === index
);
const galleryPreview = galleryImages.slice(0, 3);
const galleryRemaining = galleryImages.slice(3);

---

<section class="inner-page blog-reading">
	<div class="site-shell">
		<nav class="breadcrumb" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">/</span>
			<a href="/blog">Blog</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">{post.heading}</span>
		</nav>
		<div class="blog-article-layout">
			<article class="blog-article reading-surface">
				<header class="blog-article__header">
					<p class="blog-article__kicker">Blog AJN {self ? ' · ' + self.topic : ''}</p>
					<h1 class="page-title">{post.heading}</h1>
					<p class="blog-article__description">{post.description}</p>
					<p class="blog-article__meta">
						<span>Publicado em </span>
						<time datetime={post.pubDate.toISOString()}>{formattedDate}</time>
						{post.author === 'Admin'
              ? <span> · Por <a href="/sobre-nos">AJN Consultoria e Engenharia</a></span>
              : <span> · Por {post.author}</span>}
						{post.updatedAt && <span> · Atualizado em <time datetime={post.updatedAt.toISOString()}>{formattedUpdated}</time></span>}
					</p>
				</header>

				<Image
					class="blog-article__image"
					src={post.image.src}
					alt={post.image.alt}
					width={880}
					widths={[480, 720, 880, 1100]}
					sizes="(max-width: 800px) calc(100vw - 32px), (max-width: 1100px) 70vw, 760px"
					format="webp"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>

				{toc.length > 1 ? (
					<nav class="blog-article__toc" aria-label="Nesta publicação">
						<h2>Neste artigo</h2>
						<ol>{toc.map((entry) => <li><a href={'#' + entry.id}>{entry.title}</a></li>)}</ol>
					</nav>
				) : null}

				<div class="blog-article__content">
					{post.sections.map((section, index) => (
						<div id={'blog-secao-' + (index + 1)} class="blog-article__section">
							<ContentSections sections={[section]} />
						</div>
					))}
				</div>

				<aside class="blog-article__contact" aria-labelledby="blog-contact-title">
					<div>
						<p>Próximo passo</p>
						<h2 id="blog-contact-title">Quer avaliar esse tema na sua empresa?</h2>
						<p>{ctaDescription}</p>
					</div>
					<a href="/contato">Conversar com a AJN <span aria-hidden="true">→</span></a>
				</aside>

				{relatedServices.length > 0 && (
					<nav class="blog-article__service-links" aria-label="Serviços relacionados a este artigo">
						<p class="blog-article__service-links-heading">Precisa de apoio com esse assunto?</p>
						<ul>{relatedServices.map((service) => (
							<li><a href={service.href}>{service.title}<span aria-hidden="true"> →</span></a></li>
						))}</ul>
					</nav>
				)}

				{galleryImages.length > 0 && (
					<section class="blog-article__gallery-section" aria-labelledby="article-gallery-title">
						<h2 id="article-gallery-title">Imagens relacionadas</h2>
						<div class="blog-article__gallery" aria-label="Galeria do artigo">
							{galleryPreview.map((image) => (
								<Image src={image.src} alt={image.alt} width={440} widths={[240, 320, 440, 600]} sizes="(max-width: 620px) 45vw, (max-width: 900px) 30vw, 200px" format="webp" loading="lazy" decoding="async" />
							))}
						</div>
						{galleryRemaining.length > 0 && (
							<details class="blog-article__gallery-more">
								<summary>Ver mais {galleryRemaining.length} imagens</summary>
								<div class="blog-article__gallery">
									{galleryRemaining.map((image) => (
										<Image src={image.src} alt={image.alt} width={440} widths={[240, 320, 440, 600]} sizes="(max-width: 620px) 45vw, (max-width: 900px) 30vw, 200px" format="webp" loading="lazy" decoding="async" />
									))}
								</div>
							</details>
						)}
					</section>
				)}

				<footer class="blog-article__footer">
					{self && (
						<a class="blog-article__topic" href={'/blog?tema=' + encodeURIComponent(self.topic)}>
							Mais artigos sobre {self.topic} <span aria-hidden="true">→</span>
						</a>
					)}
					<div class="blog-article__actions">
						<a href="/blog">← Voltar para o blog</a>
						<a href="/contato">Falar com a AJN →</a>
					</div>
				</footer>
			</article>
			<BlogSidebar context="article" currentPath={post.path} />
		</div>

		{related.length > 0 && (
			<section class="blog-related" aria-labelledby="blog-related-heading">
				<div class="blog-related__heading">
					<div>
						<p>Continue a leitura</p>
						<h2 id="blog-related-heading">Artigos do mesmo assunto</h2>
					</div>
					<a href="/blog">Ver blog completo →</a>
				</div>
				<div class="blog-related__grid">
					{related.map((item) => (
						<article class="blog-related__card">
							<a href={item.href} class="blog-related__media" aria-label={'Ler: ' + item.title}>
								<Image src={item.image} alt={item.alt} width={440} widths={[240, 360, 440, 640]} sizes="(max-width: 620px) calc(100vw - 32px), (max-width: 900px) 45vw, 300px" format="webp" loading="lazy" decoding="async" />
							</a>
							<div>
								<p>{item.topic}</p>
								<h3><a href={item.href}>{item.title}</a></h3>
							</div>
						</article>
					))}
				</div>
			</section>
		)}
	</div>
	<script type="application/ld+json" set:html={serializeJsonLd(articleSchema)} />
</section>

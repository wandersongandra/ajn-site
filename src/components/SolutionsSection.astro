---
import { services } from '../data/home';
---

<section class="section solutions" id="solucoes" aria-labelledby="solutions-title">
	<div class="site-shell">
		<h2 id="solutions-title" class="section-title section-title--green">Conheça as Nossas Soluções</h2>
		<div class="carousel-shell">
			<button class="carousel-button carousel-button--prev" type="button" data-scroll-prev="solutions-track" aria-label="Soluções anteriores">‹</button>
			<div class="solutions__track" id="solutions-track" data-scroll-track>
				{services.map((service) => (
					<article class="service-card" style={`--card-image: url('${service.image}')`}>
						<div class="service-card__overlay"></div>
						<div class="service-card__content">
							<h3>{service.title}</h3>
							<p>{service.description}</p>
							<a class="service-card__link" href={service.href}>Saiba mais</a>
						</div>
					</article>
				))}
			</div>
			<button class="carousel-button carousel-button--next" type="button" data-scroll-next="solutions-track" aria-label="Próximas soluções">›</button>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-scroll-prev],[data-scroll-next]').forEach((button) => {
		if (button.dataset.bound === 'true') return;
		button.dataset.bound = 'true';
		button.addEventListener('click', () => {
			const targetId = button.dataset.scrollPrev ?? button.dataset.scrollNext;
			const target = targetId ? document.getElementById(targetId) : null;
			if (!target) return;
			const direction = button.hasAttribute('data-scroll-prev') ? -1 : 1;
			target.scrollBy({ left: direction * Math.max(300, target.clientWidth * .72), behavior: 'smooth' });
		});
	});
</script>

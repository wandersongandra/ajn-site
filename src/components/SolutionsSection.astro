---
import { services } from '../data/home';
---

<section class="section solutions" id="solucoes" aria-labelledby="solutions-title">
	<div class="site-shell">
		<p class="eyebrow">Atuação integrada</p>
		<h2 id="solutions-title" class="section-title section-title--green">Nossas soluções</h2>
		<div class="solutions__track">
			{services.map((service) => (
				<article class="service-card" style={`--card-image: url('${service.image}')`}>
					<div class="service-card__overlay"></div>
					<div class="service-card__content">
						<h3>{service.title}</h3>
						<p>{service.description}</p>
						<a class="service-card__link" href="/servicos">Ver serviço <span aria-hidden="true">→</span></a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

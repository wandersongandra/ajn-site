---
import { services } from '../data/home';
import { serviceIndexItems } from '../content/services/catalog';
---

<section class="section solutions" id="solucoes" aria-labelledby="solutions-title">
	<div class="site-shell">
		<p class="eyebrow">Conheça as</p>
		<h2 id="solutions-title" class="section-title section-title--green">Nossas soluções</h2>
		<div class="solutions__track">
			{services.map((service, index) => (
				<article class="service-card" style={`--card-image: url('${service.image}')`}>
					<div class="service-card__overlay"></div>
					<div class="service-card__content">
						<h3>{service.title}</h3>
						<p>{service.description}</p>
						<a class="button button--outline" href={serviceIndexItems[index]?.href ?? '/servicos'}>Saiba mais</a>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

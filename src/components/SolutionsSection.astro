---
import { services } from '../data/home';
---

<section class="section solutions" id="solucoes" aria-labelledby="solutions-title">
	<div class="site-shell">
		<h2 id="solutions-title" class="section-title section-title--green">Conheça as Nossas Soluções</h2>
		<div class="solutions-carousel" role="region" aria-label="Carrossel contínuo de soluções">
			<div class="solutions__viewport">
				<div class="solutions__track" id="solutions-track">
					<div class="solutions__group">
						{services.map((service) => (
							<article class="service-card" style={`--card-image: url('${service.image}')`}>
								<div class="service-card__overlay"></div>
								<div class="service-card__content">
									<h3>{service.title}</h3>
									<p>{service.description}</p>
									<a class="service-card__link" href={service.href}>Saiba mais</a>
								</div>
							</article>
						))}
					</div>
					<div class="solutions__group" aria-hidden="true" inert>
						{services.map((service) => (
							<article class="service-card" style={`--card-image: url('${service.image}')`}>
								<div class="service-card__overlay"></div>
								<div class="service-card__content">
									<h3>{service.title}</h3>
									<p>{service.description}</p>
									<a class="service-card__link" href={service.href} tabindex="-1">Saiba mais</a>
								</div>
							</article>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

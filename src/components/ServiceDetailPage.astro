---
import ContentSections from './ContentSections.astro';
import PageShell from './PageShell.astro';
import type { ServiceContent } from '../content/types';

interface Props {
	page: ServiceContent;
}

const { page } = Astro.props;
---

<PageShell heading={page.heading}>
	<div class="service-detail__hero">
		<img src={page.image} alt={page.imageAlt} width="1200" height="800" loading="eager" />
	</div>
	<ContentSections sections={page.sections} />
</PageShell>

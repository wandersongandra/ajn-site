---
import PageShell from './PageShell.astro';
import type { RouteCatalogEntry } from '../content/route-catalog';

interface Props {
	heading: string;
	intro: string;
	links: readonly RouteCatalogEntry[];
}

const { heading, intro, links } = Astro.props;

function label(title: string, path: string) {
	const withoutBrand = title.replace(/\s-\sAJN Consultoria e Engenharia.*$/i, '');
	return withoutBrand || path;
}
---

<PageShell heading={heading}>
	<p class="index-intro">{intro}</p>
	<div class="link-index-grid">
		{links.map((item) => (
			<a class="link-index-item" href={item.path}>
				<span>{label(item.title, item.path)}</span>
				<small>{item.path}</small>
			</a>
		))}
	</div>
</PageShell>

---
import { about } from '../data/home';
---

<section class="about section" aria-labelledby="about-title">
	<div class="site-shell about__grid">
		<div class="about__visual" aria-label="Áreas de atuação da AJN">
			<div class="about__visual-grid" aria-hidden="true"></div>
			<div class="about__visual-orbit" aria-hidden="true">
				<span class="about__visual-ring about__visual-ring--outer"></span>
				<span class="about__visual-ring about__visual-ring--inner"></span>
				<span class="about__visual-core">AJN</span>
			</div>
			<div class="about__visual-heading">
				<span>AJN · QSSMA</span>
				<strong>Segurança, conformidade e controle.</strong>
			</div>
			<ul class="about__areas" aria-label="Principais áreas de atuação">
				{about.areas.map((area) => <li>{area}</li>)}
			</ul>
		</div>
		<div class="about__copy">
			<p class="about__eyebrow">Sobre a AJN</p>
			<h2 id="about-title">{about.title}</h2>
			{about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			<a class="button" href="/sobre-nos">Saiba mais</a>
		</div>
	</div>
</section>

---
import { about } from '../data/home';
---

<section class="about section" aria-labelledby="about-title">
	<div class="site-shell about__grid">
		<div class="about__image-wrap">
			<img class="about__image" src={about.image} alt="AJN Consultoria e Engenharia" width="800" height="520" loading="lazy" decoding="async" />
			<img class="about__secondary-image" src={about.secondaryImage} alt="Estrutura da AJN Consultoria e Engenharia" width="360" height="280" loading="lazy" decoding="async" />
		</div>
		<div class="about__copy">
			<h2 id="about-title">{about.title}</h2>
			{about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			<a class="button" href="/sobre-nos">Saiba mais</a>
		</div>
	</div>
</section>

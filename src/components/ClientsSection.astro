---
import { clients } from '../data/home';
---

<section class="section clients" aria-labelledby="clients-title">
	<div class="site-shell">
		<h2 id="clients-title" class="section-title">Clientes que confiaram no nosso trabalho</h2>
		<div class="carousel-shell">
			<button class="carousel-button carousel-button--prev" type="button" data-scroll-prev="clients-track" aria-label="Clientes anteriores">‹</button>
			<div class="clients__track" id="clients-track" data-scroll-track>
				{clients.map((client) => <div class="client-logo"><img src={client.src} alt={client.alt} width="180" height="100" loading="lazy" /></div>)}
			</div>
			<button class="carousel-button carousel-button--next" type="button" data-scroll-next="clients-track" aria-label="Próximos clientes">›</button>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-scroll-prev],[data-scroll-next]').forEach((button) => {
		button.addEventListener('click', () => {
			const targetId = button.dataset.scrollPrev ?? button.dataset.scrollNext;
			const target = targetId ? document.getElementById(targetId) : null;
			if (!target) return;
			const direction = button.hasAttribute('data-scroll-prev') ? -1 : 1;
			target.scrollBy({ left: direction * Math.max(280, target.clientWidth * .72), behavior: 'smooth' });
		});
	});
</script>

---
import { Image } from 'astro:assets';
import PageShell from './PageShell.astro';
import BlogSidebar from './BlogSidebar.astro';
import { blogPosts } from '../content/blog/catalog';

const formatDate = (date: Date) => date.toLocaleDateString('pt-BR', {
	day: '2-digit',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
}).toUpperCase();
---

<PageShell heading="Blog">
	<div class="blog-index-layout">
		<BlogSidebar />
		<section class="blog-index-list" aria-label="Postagens do Blog">
			<div class="blog-grid blog-grid--archive">
				{blogPosts.map((post) => (
					<article class="blog-card" data-blog-card data-blog-title={post.title.toLocaleLowerCase('pt-BR')} data-blog-tags={post.tags.join(' ').toLocaleLowerCase('pt-BR')}>
						<a class="blog-card__image" href={post.href}>
							<Image src={post.image} alt={post.alt} width={900} format="webp" loading="lazy" />
						</a>
						<div class="blog-card__body">
							<time class="blog-card__date" datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
							<h2><a href={post.href}>{post.title}</a></h2>
							<a class="blog-card__link" href={post.href}>Leia mais</a>
						</div>
					</article>
				))}
			</div>
		</section>
	</div>
</PageShell>

---
import '../styles/blog.css';
import { Image } from 'astro:assets';
import PageShell from './PageShell.astro';
import BlogSidebar from './BlogSidebar.astro';
import { blogPosts } from '../content/blog/catalog';

const formatDate = (date: Date) => date.toLocaleDateString('pt-BR', {
	day: '2-digit',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});
---

<div class="blog-hub">
	<PageShell heading="Blog">
		<div class="blog-hub__intro">
			<p class="blog-hub__eyebrow">Biblioteca técnica AJN</p>
			<p>Artigos sobre segurança do trabalho, laudos, gestão de riscos e saúde ocupacional. Escolha um assunto ou pesquise por termo.</p>
		</div>

		<nav class="blog-hub__starting-points" aria-label="Guias para começar">
			<p>Comece por aqui</p>
			<ul>
				<li><a href="/blog/laudo-tecnico-das-condicoes-ambientais-de-trabalho-ltcat">Entenda o LTCAT <span aria-hidden="true">↗</span></a></li>
				<li><a href="/blog/laudo-de-gerenciamento-de-riscos-essencial-para-garantir-a-seguranca-no-ambiente-de-trabalho">Como funciona o PGR <span aria-hidden="true">↗</span></a></li>
				<li><a href="/blog/seguranca-do-trabalho-e-pcmso-gestao-da-saude-ocupacional">PCMSO e saúde ocupacional <span aria-hidden="true">↗</span></a></li>
			</ul>
		</nav>

		<div class="blog-index-layout">
			<BlogSidebar context="archive" />
			<section class="blog-index-list" aria-labelledby="blog-archive-title">
				<div class="blog-archive__heading">
					<div>
						<p class="blog-archive__overline">Publicações</p>
						<h2 id="blog-archive-title">Artigos e orientações</h2>
					</div>
					<p class="blog-archive__count" role="status" aria-live="polite" aria-atomic="true" data-blog-results>{blogPosts.length} artigos</p>
				</div>
				<div class="blog-grid blog-grid--archive" id="blog-archive-grid" data-blog-grid>
					{blogPosts.map((post) => (
						<article class="blog-card" data-blog-card data-blog-searchable={[post.title, post.description, post.topic, ...post.tags].join(' ')} data-blog-category={post.topic}>
							<a class="blog-card__image" href={post.href} aria-label={'Ler: ' + post.title}>
								<Image src={post.image} alt={post.alt} width={640} widths={[320, 480, 640, 800]} sizes="(max-width: 620px) calc(100vw - 32px), (max-width: 1100px) 45vw, 380px" format="webp" loading="lazy" decoding="async" />
							</a>
							<div class="blog-card__body">
								<p class="blog-card__category">{post.topic}</p>
								<time class="blog-card__date" datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
								<h3><a href={post.href}>{post.title}</a></h3>
								<p class="blog-card__summary">{post.description}</p>
								<a class="blog-card__link" href={post.href} aria-label={'Ler artigo: ' + post.title}>Ler artigo <span aria-hidden="true">→</span></a>
							</div>
						</article>
					))}
				</div>
				<div class="blog-empty" data-blog-empty hidden role="status">
					<h3>Nenhum artigo encontrado</h3>
					<p>Tente um termo mais curto ou consulte todos os assuntos disponíveis.</p>
					<button type="button" class="blog-empty__reset" data-blog-reset>Limpar filtros</button>
				</div>
				<div class="blog-archive__more" data-blog-more-wrap hidden>
					<button type="button" class="blog-archive__more-button" data-blog-more aria-controls="blog-archive-grid">Mostrar mais artigos</button>
				</div>
			</section>
		</div>
	</PageShell>
</div>

<script src="/scripts/blog-index.js" is:inline defer></script>

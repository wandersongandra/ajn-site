---
import { blogPosts, blogTopics } from '../content/blog/catalog';

interface Props {
	context?: 'archive' | 'article';
	currentPath?: string;
}
const { context = 'archive', currentPath } = Astro.props;
const recentPosts = blogPosts.filter((post) => post.href !== currentPath).slice(0, 4);
const usedTopics = blogTopics.filter((topic) => blogPosts.some((post) => post.topic === topic));
---

<aside class="blog-sidebar" aria-label="Explorar conteúdo do blog">
	<form class="blog-sidebar__search" action="/blog" method="get" role="search" data-blog-form>
		<label for="blog-search">Pesquisar artigos</label>
		<div class="blog-sidebar__search-row">
			<input id="blog-search" name="q" type="search" placeholder="Ex.: LTCAT, PGR, NR-35" autocomplete="off" data-blog-search aria-controls={context === "archive" ? "blog-archive-grid" : undefined} />
			<button type="submit" aria-label="Pesquisar artigos">Buscar</button>
		</div>
	</form>
	<section class="blog-sidebar__topics" aria-labelledby="blog-topics-title">
		<h2 id="blog-topics-title">Assuntos</h2>
		<nav aria-label="Filtrar blog por assunto">
			<ul class="blog-sidebar__topic-list">
				<li><a href="/blog" data-blog-topic="">Todos os artigos <span>{blogPosts.length}</span></a></li>
				{usedTopics.map((topic) => (
					<li>
						<a href={'/blog?tema=' + encodeURIComponent(topic)} data-blog-topic={topic}>
							{topic} <span>{blogPosts.filter((post) => post.topic === topic).length}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	</section>
	{context === 'article' && (
		<section class="blog-sidebar__recent" aria-labelledby="blog-recent-title">
			<h2 id="blog-recent-title">Outras leituras</h2>
			<ul>
				{recentPosts.map((post) => <li><a href={post.href}>{post.title}</a></li>)}
			</ul>
		</section>
	)}
</aside>

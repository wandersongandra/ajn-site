---
import { blogPages } from '../content/blog';

const tags = [...new Set(blogPages.flatMap((post) => post.tags))].slice(0, 8);
---

<aside class="blog-sidebar" aria-label="Filtros do Blog">
	<form class="blog-sidebar__search" action="/blog/" method="get" role="search">
		<label for="blog-search" class="sr-only">Buscar no Blog</label>
		<input id="blog-search" name="q" type="search" data-blog-search placeholder="Buscar artigos" />
	</form>
	<section>
		<h2>Tópicos</h2>
		<div class="blog-sidebar__tags">
			{tags.map((tag) => <a href={`/blog/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
		</div>
	</section>
</aside>

<script>
	const search = document.querySelector<HTMLInputElement>('[data-blog-search]');
	const cards = [...document.querySelectorAll<HTMLElement>('[data-blog-card]')];
	const params = new URLSearchParams(window.location.search);
	const requestedTag = params.get('tag')?.trim().toLocaleLowerCase('pt-BR') ?? '';
	const requestedQuery = params.get('q')?.trim().toLocaleLowerCase('pt-BR') ?? '';

	const applyFilters = () => {
		if (cards.length === 0) return;
		const query = search?.value.trim().toLocaleLowerCase('pt-BR') ?? '';
		cards.forEach((card) => {
			const title = card.dataset.blogTitle ?? '';
			const tags = card.dataset.blogTags ?? '';
			const matchesQuery = !query || title.includes(query) || tags.includes(query);
			const matchesTag = !requestedTag || tags.includes(requestedTag);
			card.hidden = !(matchesQuery && matchesTag);
		});
	};

	if (search) {
		search.value = requestedQuery;
		search.addEventListener('input', applyFilters);
	}

	applyFilters();
</script>

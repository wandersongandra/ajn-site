---
import { site } from '../data/home';

// Seleção editorial: somente publicações públicas conferidas e vinculadas ao perfil AJN.
// Links indisponíveis ficam fora do site até nova verificação.
// O site não carrega scripts do Instagram, cookies ou vídeos antes do clique do visitante.
const posts = [
  {
    kind: 'Reel',
    category: 'Higiene ocupacional',
    title: 'Insalubridade: avaliação técnica e prevenção',
    description: 'Como a análise das condições de exposição ajuda a orientar medidas de prevenção.',
    href: 'https://www.instagram.com/reel/DUagMmhkTBG/',
  },
  {
    kind: 'Reel',
    category: 'Engenharia em campo',
    title: 'Içamento de chillers no Shopping Tatuapé',
    description: 'Acompanhamento de uma operação de içamento e análise do plano de rigging.',
    href: 'https://www.instagram.com/reel/DSKuL-yEXrF/',
  },
  {
    kind: 'Reel',
    category: 'Prevenção de acidentes',
    title: 'Sinais de risco que precisam de atenção',
    description: 'Atos, condições e desvios operacionais que merecem correção antes de um acidente.',
    href: 'https://www.instagram.com/reel/DTxR39Yjky3/',
  },
  {
    kind: 'Publicação',
    category: 'Treinamentos',
    title: 'Treinamento de NR-35 na Hemarcon',
    description: 'Registro da capacitação em segurança para atividades em altura.',
    href: 'https://www.instagram.com/p/DUJRrqxkbkI/',
  },
  {
    kind: 'Publicação',
    category: 'Inspeções em obra',
    title: 'Segurança do trabalho na prática',
    description: 'Visita técnica, conferência documental e orientações de prevenção em campo.',
    href: 'https://www.instagram.com/p/DSmc5DGjiQW/',
  },
  {
    kind: 'Publicação',
    category: 'Segurança operacional',
    title: 'Segurança em instalação de climatização',
    description: 'Sinalização e organização das áreas de trabalho no Shopping Tatuapé.',
    href: 'https://www.instagram.com/p/DRnThhXEhtu/',
  },
] as const;
---

<section class="section instagram-highlights" aria-labelledby="instagram-highlights-title">
  <div class="site-shell">
    <div class="instagram-highlights__heading">
      <div>
        <p class="instagram-highlights__eyebrow">Registros de campo e conteúdos técnicos</p>
        <h2 id="instagram-highlights-title">Acompanhe a AJN na prática</h2>
        <p>Treinamentos, visitas técnicas e orientações sobre segurança do trabalho publicados em nosso Instagram.</p>
      </div>
      <a class="instagram-highlights__profile" href={site.instagram} target="_blank" rel="noopener noreferrer">Conhecer o perfil <span aria-hidden="true">↗</span></a>
    </div>
    <div class="instagram-highlights__rail" role="region" aria-label="Publicações selecionadas do Instagram da AJN" tabindex="0">
      {posts.map((post, index) => (
        <article class="instagram-highlights__card">
          <a href={post.href} class="instagram-highlights__link" target="_blank" rel="noopener noreferrer" aria-label={`Abrir no Instagram: ${post.title}`}>
            <div class="instagram-highlights__top">
              <span class="instagram-highlights__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="instagram-highlights__kind">{post.kind}</span>
            </div>
            <div class="instagram-highlights__body">
              <span class="instagram-highlights__category">{post.category}</span>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
            </div>
            <span class="instagram-highlights__action">Ver no Instagram <span aria-hidden="true">↗</span></span>
          </a>
        </article>
      ))}
    </div>
    <p class="instagram-highlights__note">Deslize para ver outras publicações. Os vídeos e as fotos abrem diretamente no Instagram.</p>
  </div>
</section>

<style>
  .instagram-highlights { padding-block: clamp(3.5rem, 6vw, 5.5rem); background: #f6f8f5; }
  .instagram-highlights__heading { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: 1.5rem; }
  .instagram-highlights__eyebrow { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: #49664b; font-weight: 700; margin-bottom: .65rem; }
  .instagram-highlights__heading h2 { font-size: clamp(1.7rem, 3vw, 2.5rem); color: #204a2b; margin: 0 0 .7rem; line-height: 1.12; }
  .instagram-highlights__heading p:not(.instagram-highlights__eyebrow) { max-width: 65ch; color: #475249; margin: 0; line-height: 1.65; }
  .instagram-highlights__profile { flex-shrink: 0; font-weight: 700; color: #205633; text-decoration: underline; text-underline-offset: .25em; padding: .7rem .2rem; }
  .instagram-highlights__rail { display: grid; grid-auto-columns: minmax(255px, 31%); grid-auto-flow: column; overflow-x: auto; overscroll-behavior-inline: contain; scroll-snap-type: x mandatory; gap: 1rem; padding: .2rem .1rem 1.1rem; scrollbar-width: thin; scrollbar-color: #7d987d transparent; }
  .instagram-highlights__card { min-width: 0; border: 1px solid #d8e1d6; background: #fff; border-radius: 12px; scroll-snap-align: start; }
  .instagram-highlights__link { min-height: 300px; height: 100%; display: flex; flex-direction: column; padding: 1.35rem; color: inherit; text-decoration: none; transition: border-color .2s ease, transform .2s ease; border-radius: inherit; }
  .instagram-highlights__link:hover { transform: translateY(-3px); }
  .instagram-highlights__link:focus-visible { outline: 3px solid #276e3f; outline-offset: 3px; }
  .instagram-highlights__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid #edf0eb; padding-bottom: 1.1rem; }
  .instagram-highlights__index { font-size: 1.8rem; font-weight: 700; letter-spacing: -.06em; color: #aac0ac; }
  .instagram-highlights__kind { border: 1px solid #c8d8c8; color: #355e3a; border-radius: 99px; font-size: .7rem; padding: .34rem .6rem; }
  .instagram-highlights__body { flex: 1; padding: 1.3rem 0; }
  .instagram-highlights__category { display: block; color: #396342; font-size: .74rem; font-weight: 700; letter-spacing: .02em; margin-bottom: .65rem; }
  .instagram-highlights__body h3 { color: #1d3323; font-size: 1.19rem; line-height: 1.3; margin: 0 0 .8rem; }
  .instagram-highlights__body p { color: #4e5a51; font-size: .93rem; line-height: 1.6; margin: 0; }
  .instagram-highlights__action { color: #245b37; font-weight: 700; font-size: .83rem; display: flex; justify-content: space-between; gap: .5rem; padding-top: 1rem; border-top: 1px solid #edf0eb; }
  .instagram-highlights__note { color: #536356; font-size: .78rem; margin: .35rem 0 0; }
  @media (max-width: 850px) { .instagram-highlights__rail { grid-auto-columns: minmax(255px, 54%); } }
  @media (max-width: 600px) { .instagram-highlights__heading { align-items: start; flex-direction: column; } .instagram-highlights__rail { grid-auto-columns: minmax(255px, 88%); } .instagram-highlights__link { min-height: 285px; } }
  @media (prefers-reduced-motion: reduce) { .instagram-highlights__rail { scroll-behavior: auto; } .instagram-highlights__link { transition: none; } .instagram-highlights__link:hover { transform: none; } }
</style>

---
import { workflowSteps } from '../data/home';
---

<section class="differentials section" aria-labelledby="differentials-title">
	<div class="site-shell">
		<p class="home-section-heading__eyebrow">Nosso processo</p>
		<h2 id="differentials-title" class="section-title" data-reveal>Como atendemos sua empresa.</h2>
		<p class="workflow__intro">Entenda as etapas, desde o levantamento inicial até a entrega do serviço.</p>
		<ol class="workflow__steps">
			{workflowSteps.map((step, index) => (
				<li class="workflow__step" data-reveal style={`--reveal-delay: ${index * 65}ms`}>
					<div class="workflow__step-icon" aria-hidden="true">
						{step.icon === 'diagnostic' && (
							<svg viewBox="0 0 24 24" focusable="false"><circle cx="10.5" cy="10.5" r="6.25" /><path d="m15.2 15.2 4.5 4.5" /></svg>
						)}
						{step.icon === 'proposal' && (
							<svg viewBox="0 0 24 24" focusable="false"><path d="M6 3.5h8l4 4V20.5H6z" /><path d="M14 3.5v4h4M9 12h6M9 15.5h6" /></svg>
						)}
						{step.icon === 'execution' && (
							<svg viewBox="0 0 24 24" focusable="false"><path d="M4 17.5h16M6 17.5v-5h12v5M8 12.5V9.8a4 4 0 0 1 8 0v2.7M5 20.5h14" /></svg>
						)}
						{step.icon === 'follow-up' && (
							<svg viewBox="0 0 24 24" focusable="false"><path d="M5 13.5v-2a7 7 0 0 1 14 0v2M5 13.5H3.5v3H7v-3M19 13.5h1.5v3H17v-3M17 16.5c-.8 2-2.4 3-5 3" /><path d="M9.5 10.5h5" /></svg>
						)}
					</div>
					<span class="workflow__step-number">{step.number}</span>
					<h3>{step.title}</h3>
					<p>{step.text}</p>
				</li>
			))}
		</ol>
	</div>
</section>

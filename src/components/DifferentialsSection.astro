---
import { workflowSteps } from '../data/home';
---

<section class="differentials section" aria-labelledby="differentials-title">
	<div class="site-shell">
		<div class="workflow__heading" data-reveal>
			<div>
				<p class="home-section-heading__eyebrow">Nosso processo</p>
				<h2 id="differentials-title" class="section-title">Da primeira conversa à entrega do serviço</h2>
			</div>
			<p class="workflow__intro">Primeiro definimos a demanda e o escopo. Depois, realizamos o trabalho previsto e orientamos sobre os próximos passos.</p>
		</div>

		<ol class="workflow__steps" aria-label="Etapas do atendimento da AJN">
			{workflowSteps.map((step, index) => (
				<li class="workflow__step" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
					<span class="workflow__step-number" aria-hidden="true">{step.number}</span>
					<div class="workflow__step-copy">
						<h3>{step.title}</h3>
						<p>{step.text}</p>
					</div>
				</li>
			))}
		</ol>
	</div>
</section>

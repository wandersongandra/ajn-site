---
import { navigation, site } from '../data/home';
---
<footer class="site-footer">
	<div class="site-shell footer__grid">
		<div><img class="footer__logo" src="/images/branding/logo.png" alt={site.name} width="200" height="80" /><p class="footer__legal">Razão Social: AJN Consultoria e Engenharia</p><p class="footer__legal">CNPJ: 50.970.588/0001-84</p></div>
		<div class="footer__menu"><h2>NAVEGAÇÃO</h2><ul>{navigation.slice(0, 6).map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></div>
		<div class="footer__contact"><h2>CONTATO</h2><a href={site.phoneHref} rel="nofollow" target="_blank">{site.phone}</a><a href={`mailto:${site.email}`}>{site.email}</a><p>{site.address}<br />{site.postalCode}</p><div class="footer__social"><a href={site.instagram} target="_blank" rel="nofollow noopener noreferrer"><img src="/images/icons/instagram.png" alt="Instagram" width="38" height="38" /></a><a href={site.linkedin} target="_blank" rel="nofollow noopener noreferrer"><img src="/images/icons/linkedin.png" alt="LinkedIn" width="38" height="38" /></a></div></div>
	</div>
	<div class="copyright-footer"><div class="site-shell copyright-footer__inner"><span>Copyright © AJN Consultoria e Engenharia. (Lei 9610 de 19/02/1998)</span><img src="/images/icons/logo-icon.webp" alt="AJN" width="50" height="50" /></div></div>
</footer>

---
import { highlights } from '../data/home';
---

<section class="section highlights" aria-labelledby="highlights-title">
	<div class="site-shell">
		<h2 id="highlights-title" class="section-title">Serviços em Destaque</h2>
		<div class="carousel-shell">
			<button class="carousel-button carousel-button--prev" type="button" data-scroll-prev="highlights-track" aria-label="Destaques anteriores">‹</button>
			<div class="highlights__track" id="highlights-track" data-scroll-track>
				{highlights.map((highlight) => (
					<a class="highlight-card" href={highlight.href}>
						<img src={highlight.image} alt={`Imagem ilustrativa de ${highlight.title}`} width="600" height="360" loading="lazy" />
						<div class="highlight-card__body">
							<h3>{highlight.title}</h3>
							<span>Saiba mais</span>
						</div>
					</a>
				))}
			</div>
			<button class="carousel-button carousel-button--next" type="button" data-scroll-next="highlights-track" aria-label="Próximos destaques">›</button>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-scroll-prev],[data-scroll-next]').forEach((button) => {
		if (button.dataset.bound === 'true') return;
		button.dataset.bound = 'true';
		button.addEventListener('click', () => {
			const targetId = button.dataset.scrollPrev ?? button.dataset.scrollNext;
			const target = targetId ? document.getElementById(targetId) : null;
			if (!target) return;
			const direction = button.hasAttribute('data-scroll-prev') ? -1 : 1;
			target.scrollBy({ left: direction * Math.max(300, target.clientWidth * .72), behavior: 'smooth' });
		});
	});
</script>

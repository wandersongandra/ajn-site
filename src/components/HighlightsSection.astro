---
import { highlights } from '../data/home';
---

<section class="section highlights" aria-labelledby="highlights-title">
	<div class="site-shell">
		<h2 id="highlights-title" class="section-title">Serviços em Destaque</h2>
		<div class="highlights-carousel" role="region" aria-label="Carrossel contínuo de serviços em destaque">
			<div class="highlights__viewport">
				<div class="highlights__track" id="highlights-track">
					<div class="highlights__group">
						{highlights.map((highlight) => (
							<a class="highlight-card" href={highlight.href}>
								<img src={highlight.image} alt={`Imagem ilustrativa de ${highlight.title}`} width="600" height="360" loading="lazy" />
								<div class="highlight-card__body">
									<h3>{highlight.title}</h3>
									<span>Saiba mais</span>
								</div>
							</a>
						))}
					</div>
					<div class="highlights__group" aria-hidden="true" inert>
						{highlights.map((highlight) => (
							<a class="highlight-card" href={highlight.href} tabindex="-1">
								<img src={highlight.image} alt="" width="600" height="360" loading="lazy" />
								<div class="highlight-card__body">
									<h3>{highlight.title}</h3>
									<span>Saiba mais</span>
								</div>
							</a>
						))}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

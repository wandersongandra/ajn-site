---
import { portfolio } from '../data/home';
---

<section class="section portfolio" aria-labelledby="portfolio-title">
	<div class="site-shell">
		<p class="eyebrow">Conheça mais sobre a AJN</p>
		<h2 id="portfolio-title" class="section-title section-title--green">Nosso Portfólio</h2>
		<div class="portfolio__grid">
			{portfolio.map((item, index) => <img class={`portfolio__item portfolio__item--${index + 1}`} src={item.src} alt={item.alt} width="600" height="400" loading="lazy" />)}
		</div>
	</div>
</section>

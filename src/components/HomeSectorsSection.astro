---
const sectors = [
	{ number: '01', name: 'Indústria', description: 'Avaliações, documentação de SST e apoio técnico às rotinas de prevenção.' },
	{ number: '02', name: 'Construção e obras', description: 'Segurança do trabalho, inspeções e projetos aplicáveis às atividades em campo.' },
	{ number: '03', name: 'Comércio e serviços', description: 'Organização das obrigações de saúde ocupacional e gestão dos riscos da atividade.' },
	{ number: '04', name: 'Equipes terceirizadas', description: 'Apoio na mobilização, documentação e acompanhamento técnico, conforme o contrato.' },
];
---
<section class="section home-sectors" aria-labelledby="home-sectors-title">
	<div class="site-shell home-sectors__layout">
		<div class="home-sectors__heading">
			<p class="home-section-heading__eyebrow">Onde podemos atuar</p>
			<h2 id="home-sectors-title" class="section-title">Cada operação tem riscos e exigências próprias.</h2>
			<p>O escopo dos serviços considera o tipo de atividade, as condições de trabalho e as necessidades de cada empresa.</p>
			<a class="home-sectors__link" href="/contato">Fale com nossa equipe <span aria-hidden="true">↗</span></a>
		</div>
		<div class="home-sectors__grid">
			{sectors.map((sector) => (
				<article class="home-sector-card">
					<span class="home-sector-card__number" aria-hidden="true">{sector.number}</span>
					<h3>{sector.name}</h3>
					<p>{sector.description}</p>
				</article>
			))}
		</div>
	</div>
</section>

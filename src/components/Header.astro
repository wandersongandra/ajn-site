---
import { navigation, site } from '../data/home';
---

<header class="site-header" id="site-header">
	<div class="topbar">
		<div class="site-shell topbar__inner">
			<span class="topbar__address">{site.address}</span>
			<div class="topbar__contacts">
				<a href={site.phoneHref} rel="nofollow" target="_blank">{site.phone}</a>
				<a href={`mailto:${site.email}`}>{site.email}</a>
			</div>
		</div>
	</div>

	<div class="site-shell header-main">
		<a class="brand" href="/" aria-label="Voltar para a página inicial">
			<img src="/images/branding/logo.png" alt={site.name} width="200" height="80" />
		</a>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
			<span class="sr-only">Abrir menu</span>
			<span></span><span></span><span></span>
		</button>
		<nav id="primary-navigation" class="primary-navigation" aria-label="Navegação principal">
			<ul>
				{navigation.map((item) => (
					<li class={item.children ? 'has-submenu' : undefined}>
						<a href={item.href}>{item.label}</a>
						{item.children && (
							<ul class="submenu">
								{item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
							</ul>
						)}
					</li>
				))}
				<li><a class="training-link" href={site.trainingUrl} target="_blank" rel="noopener noreferrer">Treinamentos online</a></li>
			</ul>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const navigation = document.querySelector<HTMLElement>('.primary-navigation');

	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!open));
		navigation?.classList.toggle('is-open', !open);
	});
</script>

---
import '../styles/header.css';
import { navigation, site } from '../data/home';

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const isCurrent = (href: string) => href === '/'
	? currentPath === '/'
	: currentPath === href || currentPath.startsWith(href + '/');
---

<header class="site-header" id="site-header">
	<div class="site-shell header-main">
		<a class="brand" href="/" aria-label="AJN Consultoria e Engenharia — página inicial">
			<img src="/images/branding/ajn-logo-hd.webp" alt="AJN Consultoria e Engenharia" width="80" height="80" decoding="async" />
		</a>

		<button
			class="menu-toggle"
			type="button"
			aria-label="Abrir menu de navegação"
			aria-expanded="false"
			aria-controls="primary-navigation"
			data-menu-toggle
		>
			<span class="sr-only">Abrir menu</span>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</button>

		<nav id="primary-navigation" class="primary-navigation" aria-label="Navegação principal">
			<ul class="navigation-list">
				{navigation.map((item) => (
					<li class={item.children ? 'has-submenu' : undefined}>
						{item.children ? (
							<>
								<div class="navigation-item__group">
									<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
										{item.label}
									</a>
									<button
										class="submenu-toggle"
										type="button"
										aria-expanded="false"
										aria-controls={'submenu-' + item.href.slice(1)}
										aria-label={'Expandir opções de ' + item.label}
										data-submenu-toggle
									>
										<span class="submenu-toggle__chevron" aria-hidden="true"></span>
									</button>
								</div>
								<ul id={'submenu-' + item.href.slice(1)} class="submenu" aria-label={'Opções de ' + item.label}>
									{item.children.map((child) => (
										<li><a href={child.href} aria-current={currentPath === child.href ? 'page' : undefined}>{child.label}</a></li>
									))}
								</ul>
							</>
						) : (
							<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
						)}
					</li>
				))}
				<li class="navigation-list__action">
					<a class="training-link" href={site.trainingUrl} target="_blank" rel="noopener noreferrer">
						Treinamentos online
						<span class="sr-only"> (abre em uma nova aba)</span>
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<script src="/scripts/header.js" is:inline defer></script>

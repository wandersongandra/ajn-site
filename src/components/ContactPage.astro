---
import PageShell from './PageShell.astro';
import { site } from '../data/home';

const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT?.trim() ?? '';
---

<PageShell heading="Contato">
	<div class="contact-layout">
		<section class="contact-page contact-page--info" aria-labelledby="contact-info-title">
			<h2 id="contact-info-title">Fale conosco!</h2>
			<h3>Endereço</h3>
			<p>{site.fullAddress}</p>
			<h3>Telefone</h3>
			<p><a class="contact-page__phone" href={site.phoneHref} target="_blank" rel="nofollow noopener noreferrer">{site.phone}</a></p>
			<h3>E-mail</h3>
			<p><a href={`mailto:${site.email}`}>{site.email}</a></p>
			<h3>Redes sociais</h3>
			<div class="contact-page__social">
				<a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
				<a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
			</div>
		</section>

		<section class="contact-page contact-page--form" aria-labelledby="contact-form-title">
			<h2 id="contact-form-title">Envie sua Mensagem</h2>
			<form
				class="contact-form"
				data-contact-form
				action={contactEndpoint || undefined}
				method="post"
				enctype="multipart/form-data"
				data-contact-endpoint={contactEndpoint || undefined}
				aria-describedby="contact-form-status"
			>
				<div class="contact-form__row">
					<div class="contact-form__field">
						<label for="contact-name">Nome</label>
						<input id="contact-name" name="nome" type="text" autocomplete="name" required />
					</div>
					<div class="contact-form__field">
						<label for="contact-email">E-mail</label>
						<input id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" required />
					</div>
				</div>

				<div class="contact-form__row">
					<div class="contact-form__field">
						<label for="contact-phone">Telefone</label>
						<input id="contact-phone" name="telefone" type="tel" autocomplete="tel" inputmode="tel" required />
					</div>
					<div class="contact-form__field">
						<label for="contact-source">Como nos conheceu</label>
						<select id="contact-source" name="como_nos_conheceu" required>
							<option value="">Selecione</option>
							<option>Busca do Google</option>
							<option>Outros Buscadores</option>
							<option>Indicação</option>
							<option>Outros</option>
						</select>
					</div>
				</div>

				<div class="contact-form__field">
					<label for="contact-attachment">Anexo</label>
					<input id="contact-attachment" name="anexo" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
				</div>

				<div class="contact-form__field">
					<label for="contact-message">Mensagem</label>
					<textarea id="contact-message" name="mensagem" rows="6" required></textarea>
				</div>

				<button class="button" type="submit">Enviar mensagem</button>
				<p id="contact-form-status" class="contact-form__status" data-contact-status role="status" aria-live="polite">
					O envio online depende da configuração do serviço de contato da produção.
				</p>
			</form>
		</section>
	</div>
</PageShell>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const status = document.querySelector<HTMLElement>('[data-contact-status]');
	const contactEndpoint = form?.dataset.contactEndpoint?.trim() ?? '';

	form?.addEventListener('submit', (event) => {
		if (contactEndpoint) return;
		event.preventDefault();
		if (!form.reportValidity()) return;
		if (status) {
			status.textContent = 'O formulário está validado, mas o envio ainda não está habilitado neste ambiente.';
			status.focus?.();
		}
	});
</script>

---
import PageShell from './PageShell.astro';
import { site } from '../data/home';

const configuredEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT?.trim() ?? '';
// Sem endpoint HTTPS confirmado, não renderizamos um formulário que não pode enviar.
const contactEndpoint = (() => {
	try {
		const url = new URL(configuredEndpoint);
		return url.protocol === 'https:' && !url.username && !url.password ? url.href : '';
	} catch {
		return '';
	}
})();
---

<PageShell heading="Contato">
	<div class="contact-layout">
		<section class="contact-page contact-page--info" aria-labelledby="contact-info-title">
			<div class="contact-page__intro">
				<p class="contact-page__eyebrow">Atendimento AJN</p>
				<h2 id="contact-info-title">Fale com nossa equipe</h2>
				<p>Use os canais abaixo para falar com a AJN Consultoria e Engenharia.</p>
			</div>

			<div class="contact-details" aria-label="Canais de contato">
				<div class="contact-detail">
					<span class="contact-detail__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" focusable="false"><path d="M12 21s7-6.14 7-12A7 7 0 0 0 5 9c0 5.86 7 12 7 12Z" /><circle cx="12" cy="9" r="2.25" /></svg>
					</span>
					<div>
						<h3>Endereço</h3>
						<address>{site.fullAddress}</address>
					</div>
				</div>

				<div class="contact-detail">
					<span class="contact-detail__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" focusable="false"><path d="M6.6 3.5 9.1 3l2 4.7-1.8 1.5a14.2 14.2 0 0 0 5.5 5.5l1.5-1.8 4.7 2-.5 2.5a2 2 0 0 1-2 1.6C11 18.8 5.2 13 5 5.5a2 2 0 0 1 1.6-2Z" /></svg>
					</span>
					<div>
						<h3>Telefone e WhatsApp</h3>
						<a class="contact-page__phone" href={site.phoneHref} target="_blank" rel="nofollow noopener noreferrer">{site.phone}</a>
					</div>
				</div>

				<div class="contact-detail">
					<span class="contact-detail__icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" focusable="false"><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m4 7 8 6 8-6" /></svg>
					</span>
					<div>
						<h3>E-mail</h3>
						<a class="contact-page__email" href={`mailto:${site.email}`}>{site.email}</a>
					</div>
				</div>
			</div>

			<nav class="contact-page__social" aria-label="Redes sociais">
				<a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a>
				<a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
			</nav>
		</section>

		{contactEndpoint ? (
			<section class="contact-page contact-page--form" aria-labelledby="contact-form-title">
				<div class="contact-page__form-header">
					<p class="contact-page__eyebrow">Fale com a AJN</p>
					<h2 id="contact-form-title">Envie sua mensagem</h2>
					<p>Preencha os campos abaixo e conte brevemente como podemos ajudar.</p>
				</div>
				<form
					class="contact-form"
					data-contact-form
					action={contactEndpoint || undefined}
					method="post"
					enctype="multipart/form-data"
					data-contact-endpoint={contactEndpoint || undefined}
					aria-describedby="contact-form-help contact-form-status"
				>
					<div class="contact-form__row">
						<div class="contact-form__field">
							<label for="contact-name">Nome <span aria-hidden="true">*</span></label>
							<input id="contact-name" name="nome" type="text" autocomplete="name" required />
						</div>
						<div class="contact-form__field">
							<label for="contact-email">E-mail <span aria-hidden="true">*</span></label>
							<input id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" required />
						</div>
					</div>
	
					<div class="contact-form__row">
						<div class="contact-form__field">
							<label for="contact-phone">Telefone <span aria-hidden="true">*</span></label>
							<input id="contact-phone" name="telefone" type="tel" autocomplete="tel" inputmode="tel" required />
						</div>
						<div class="contact-form__field">
							<label for="contact-source">Como nos conheceu <span aria-hidden="true">*</span></label>
							<select id="contact-source" name="como_nos_conheceu" required>
								<option value="">Selecione</option>
								<option>Busca do Google</option>
								<option>Outros Buscadores</option>
								<option>Indicação</option>
								<option>Outros</option>
							</select>
						</div>
					</div>
	
					<div class="contact-form__field">
						<label for="contact-attachment">Anexo</label>
						<input id="contact-attachment" name="anexo" type="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
						<small>PDF, DOC, DOCX, JPG ou PNG.</small>
					</div>
	
					<div class="contact-form__field">
						<label for="contact-message">Mensagem <span aria-hidden="true">*</span></label>
						<textarea id="contact-message" name="mensagem" rows="6" required></textarea>
					</div>
	
					<button class="button" type="submit">Enviar mensagem</button>
					<p id="contact-form-help" class="contact-form__help">* Campos obrigatórios.</p>
					<p id="contact-form-status" class="contact-form__status" data-contact-status role="status" aria-live="polite" tabindex="-1">
						Preencha os campos obrigatórios para enviar a mensagem.
					</p>
				</form>
			</section>
		) : (
			<section class="contact-page contact-page--form" aria-labelledby="contact-form-title">
				<div class="contact-page__form-header">
					<p class="contact-page__eyebrow">Canais de atendimento</p>
					<h2 id="contact-form-title">Entre em contato sem preencher formulário</h2>
					<p>O envio pelo formulário não está disponível neste momento. Para pedir um orçamento ou esclarecer uma dúvida, fale diretamente com a AJN pelo WhatsApp ou e-mail.</p>
				</div>
				<div class="contact-page__alternate-actions">
					<a class="button" href={site.phoneHref} target="_blank" rel="noopener noreferrer">Conversar pelo WhatsApp</a>
					<a class="contact-page__email" href={`mailto:${site.email}`}>Enviar e-mail</a>
				</div>
			</section>
		)}
	</div>
</PageShell>


<style>
	.contact-page__alternate-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px 24px;
		margin-top: 24px;
	}
	.contact-page__alternate-actions .contact-page__email {
		display: inline-block;
		padding-block: 12px;
		overflow-wrap: anywhere;
	}
</style>

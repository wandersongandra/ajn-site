---
import type { ContentSection } from '../content/types';
import ContentList from './ContentList.astro';
import ContentParagraphView from './ContentParagraph.astro';

interface Props {
	sections: readonly ContentSection[];
}

const { sections } = Astro.props;

---

{sections.map((section) => (
	<section class="content-section">
		{section.heading ? <h2>{section.heading}</h2> : null}
		{section.paragraphs.map((paragraph) => <ContentParagraphView paragraph={paragraph} />)}
		{section.lists?.map((list) => <ContentList list={list} />)}
		{section.subsections?.map((subsection) => (
			<div class="content-subsection">
				<h3>{subsection.heading}</h3>
				{subsection.paragraphs.map((paragraph) => <ContentParagraphView paragraph={paragraph} />)}
				{subsection.lists?.map((list) => <ContentList list={list} />)}
			</div>
		))}
	</section>
))}

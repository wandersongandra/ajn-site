---
import { site } from '../data/home';
---

<aside class="social-float" aria-label="Redes sociais">
	<a href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
		<img src="/images/icons/linkedin.png" alt="" width="42" height="42" />
	</a>
	<a href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
		<img src="/images/icons/instagram.png" alt="" width="42" height="42" />
	</a>
	<a href={site.phoneHref} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
		<img src="/images/icons/whatsapp-icon.svg" alt="" width="42" height="42" />
	</a>
</aside>

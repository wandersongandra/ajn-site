---
import { hero } from '../data/home';
---

<section class="hero" style={`--hero-image: url('${hero.image}')`} aria-label="Apresentação AJN Consultoria e Engenharia">
	<div class="site-shell hero__content">
		<p class="hero__eyebrow">Engenharia · QSSMA · Segurança do Trabalho</p>
		<h1>AJN Consultoria e Engenharia</h1>
		<p class="hero__lead">{hero.text}</p>
		<div class="hero__actions">
			<a class="button" href="/servicos">Conheça nossas soluções</a>
			<a class="button button--outline" href="/sobre-nos">Conheça a AJN</a>
		</div>
		<ul class="hero__areas" aria-label="Áreas de atuação">
			<li>Qualidade</li>
			<li>Saúde e Segurança</li>
			<li>Meio Ambiente</li>
		</ul>
	</div>
</section>

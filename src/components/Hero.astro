---
import { hero } from '../data/home';
---

<section class="hero hero--surreal" aria-labelledby="hero-title">
	<div class="hero__stage" aria-hidden="true">
		<div class="hero__glow hero__glow--core" data-hero-layer="0.15"></div>
		<div class="hero__glow hero__glow--beam" data-hero-layer="0.08"></div>
		<div class="hero__glow hero__glow--rim" data-hero-layer="0.2"></div>
		<div class="hero__mist" data-hero-layer="0.12"></div>
		<div class="hero__grain"></div>
	</div>

	<div class="site-shell hero__content">
		<div class="hero__main">
			<p class="hero__eyebrow">{hero.eyebrow}</p>
			<h1 id="hero-title">{hero.title}</h1>
			<p class="hero__lead">{hero.description}</p>
			<div class="hero__actions">
				<a class="button" href="/contato">Solicitar atendimento</a>
				<a class="button button--outline" href="/servicos">Conhecer os serviços</a>
			</div>
		</div>

		<div class="hero__showcase" aria-hidden="true">
			<svg class="hero__art" viewBox="0 0 720 720" focusable="false">
				<defs>
					<radialGradient id="ajn-bloom" cx="50%" cy="36%" r="58%">
						<stop offset="0%" stop-color="#e8ffd0" stop-opacity=".78" />
						<stop offset="28%" stop-color="#9ed87a" stop-opacity=".34" />
						<stop offset="62%" stop-color="#3f7d1a" stop-opacity=".1" />
						<stop offset="100%" stop-color="#06140e" stop-opacity="0" />
					</radialGradient>
					<linearGradient id="ajn-shield-body" x1="50%" y1="0%" x2="50%" y2="100%">
						<stop offset="0%" stop-color="#f7ffe8" stop-opacity=".8" />
						<stop offset="32%" stop-color="#b6f08a" stop-opacity=".36" />
						<stop offset="70%" stop-color="#4a8f22" stop-opacity=".18" />
						<stop offset="100%" stop-color="#07160f" stop-opacity="0" />
					</linearGradient>
					<linearGradient id="ajn-shield-edge" x1="0%" y1="0%" x2="100%" y2="100%">
						<stop offset="0%" stop-color="#ffffff" stop-opacity=".98" />
						<stop offset="42%" stop-color="#d7f5c2" stop-opacity=".82" />
						<stop offset="100%" stop-color="#569d21" stop-opacity=".22" />
					</linearGradient>
					<linearGradient id="ajn-grid-fill" x1="50%" y1="0%" x2="50%" y2="100%">
						<stop offset="0%" stop-color="#c8f0a8" stop-opacity=".3" />
						<stop offset="55%" stop-color="#7ecf5a" stop-opacity=".12" />
						<stop offset="100%" stop-color="#06140e" stop-opacity="0" />
					</linearGradient>
					<linearGradient id="ajn-reflect" x1="50%" y1="0%" x2="50%" y2="100%">
						<stop offset="0%" stop-color="#e8ffd4" stop-opacity=".45" />
						<stop offset="100%" stop-color="#e8ffd4" stop-opacity="0" />
					</linearGradient>
					<linearGradient id="ajn-beam" x1="50%" y1="0%" x2="50%" y2="100%">
						<stop offset="0%" stop-color="#f5ffe4" stop-opacity=".58" />
						<stop offset="55%" stop-color="#9ed87a" stop-opacity=".14" />
						<stop offset="100%" stop-color="#7ecf5a" stop-opacity="0" />
					</linearGradient>
					<linearGradient id="ajn-mist-band" x1="0%" y1="50%" x2="100%" y2="50%">
						<stop offset="0%" stop-color="#7ecf5a" stop-opacity="0" />
						<stop offset="50%" stop-color="#c8f0a8" stop-opacity=".22" />
						<stop offset="100%" stop-color="#7ecf5a" stop-opacity="0" />
					</linearGradient>
					<filter id="ajn-soft-blur" x="-30%" y="-30%" width="160%" height="160%">
						<feGaussianBlur stdDeviation="3" />
					</filter>
					<filter id="ajn-soft-glow" x="-50%" y="-50%" width="200%" height="200%">
						<feGaussianBlur stdDeviation="14" />
					</filter>
					<filter id="ajn-tiny-blur" x="-20%" y="-20%" width="140%" height="140%">
						<feGaussianBlur stdDeviation="1.4" />
					</filter>
				</defs>

				<!-- Atmosphere (SVG position on outer; parallax on inner — CSS transform must not wipe SVG translate) -->
				<g transform="translate(0 0)">
					<g class="hero__layer hero__layer--back" data-hero-layer="0.12">
						<ellipse cx="360" cy="240" rx="280" ry="250" fill="url(#ajn-bloom)" />
						<path d="M300 -20 L360 300 L420 -20 Z" fill="url(#ajn-beam)" opacity=".72" filter="url(#ajn-soft-glow)" />
						<path d="M230 -30 L360 330 L490 -30 Z" fill="url(#ajn-beam)" opacity=".3" filter="url(#ajn-soft-glow)" />
						<path d="M160 20 L360 350 L560 20 Z" fill="url(#ajn-beam)" opacity=".12" filter="url(#ajn-soft-glow)" />
					</g>
				</g>

				<!-- Floating shield — clear of ground -->
				<g transform="translate(360 215)">
					<g class="hero__layer hero__layer--shield" data-hero-layer="0.55">
						<g class="hero__orb">
							<ellipse cx="0" cy="20" rx="150" ry="160" fill="#9ed87a" opacity=".1" filter="url(#ajn-soft-glow)" />
							<ellipse cx="0" cy="10" rx="188" ry="188" fill="none" stroke="#e8ffd4" stroke-width="1" opacity=".22" />
							<ellipse cx="0" cy="10" rx="158" ry="158" fill="none" stroke="#b6f08a" stroke-width="1.35" opacity=".42" />
							<ellipse cx="0" cy="10" rx="126" ry="126" fill="none" stroke="#f2ffd8" stroke-width=".75" opacity=".28" stroke-dasharray="4 8" />
							<path
								d="M0 -128
									C-86 -100, -132 -32, -132 48
									C-132 136, -70 200, 0 246
									C70 200, 132 136, 132 48
									C132 -32, 86 -100, 0 -128 Z"
								fill="url(#ajn-shield-body)"
								stroke="url(#ajn-shield-edge)"
								stroke-width="2.4"
								opacity=".96"
							/>
							<path
								d="M0 -86
									C-58 -64, -86 -16, -86 48
									C-86 116, -44 166, 0 200
									C44 166, 86 116, 86 48
									C86 -16, 58 -64, 0 -86 Z"
								fill="none"
								stroke="#d7f5c2"
								stroke-width="1.35"
								opacity=".7"
							/>
							<path
								d="M-48 -52 C-12 -98, 12 -98, 48 -52"
								fill="none"
								stroke="#ffffff"
								stroke-width="2.6"
								stroke-linecap="round"
								opacity=".78"
								filter="url(#ajn-soft-blur)"
							/>
							<ellipse cx="0" cy="24" rx="52" ry="66" fill="#f3ffe8" opacity=".14" filter="url(#ajn-soft-glow)" />
							<circle cx="0" cy="16" r="6" fill="#ffffff" opacity=".55" filter="url(#ajn-tiny-blur)" />
							<circle class="hero__spark" cx="168" cy="-36" r="3.4" fill="#f3ffe8" opacity=".9" />
							<circle class="hero__spark" cx="-162" cy="28" r="2.6" fill="#e8ffd4" opacity=".7" />
							<circle class="hero__spark" cx="132" cy="110" r="2.2" fill="#d7f5c2" opacity=".6" />
							<circle class="hero__spark" cx="-110" cy="-96" r="2" fill="#f3ffe8" opacity=".55" />
						</g>
					</g>
				</g>

				<!-- Mist between shield and ground -->
				<g transform="translate(0 0)">
					<g class="hero__layer hero__layer--mist" data-hero-layer="0.22">
						<ellipse cx="360" cy="455" rx="240" ry="34" fill="url(#ajn-mist-band)" filter="url(#ajn-soft-blur)" opacity=".85" />
						<ellipse cx="360" cy="485" rx="200" ry="26" fill="#9ed87a" opacity=".06" filter="url(#ajn-soft-glow)" />
					</g>
				</g>

				<!-- Reflective isometric ground — clearly BELOW the shield -->
				<g transform="translate(360 575)">
					<g class="hero__layer hero__layer--ground" data-hero-layer="0.38">
						<ellipse cx="0" cy="0" rx="250" ry="70" fill="#7ecf5a" opacity=".08" filter="url(#ajn-soft-glow)" />
						<ellipse cx="0" cy="-6" rx="90" ry="28" fill="url(#ajn-reflect)" opacity=".7" filter="url(#ajn-soft-blur)" />
						<ellipse cx="0" cy="2" rx="78" ry="16" fill="#03110a" opacity=".55" filter="url(#ajn-soft-blur)" />
						<ellipse cx="0" cy="0" rx="42" ry="9" fill="#9ed87a" opacity=".3" filter="url(#ajn-soft-blur)" />
						<path d="M0 -78 L220 0 L0 78 L-220 0 Z" fill="url(#ajn-grid-fill)" opacity=".55" />
						<path d="M0 -78 L220 0 L0 78 L-220 0 Z" fill="none" stroke="#e8ffd4" stroke-width="1.35" opacity=".55" />
						<path d="M-176 -20 L0 42 L176 -20" fill="none" stroke="#b6f08a" stroke-width=".75" opacity=".42" />
						<path d="M-132 -36 L0 22 L132 -36" fill="none" stroke="#b6f08a" stroke-width=".7" opacity=".38" />
						<path d="M-88 -52 L0 2 L88 -52" fill="none" stroke="#b6f08a" stroke-width=".65" opacity=".34" />
						<path d="M-44 -66 L0 -22 L44 -66" fill="none" stroke="#b6f08a" stroke-width=".6" opacity=".3" />
						<path d="M-176 20 L0 -42 L176 20" fill="none" stroke="#9ed87a" stroke-width=".7" opacity=".32" />
						<path d="M-132 36 L0 -22 L132 36" fill="none" stroke="#9ed87a" stroke-width=".65" opacity=".28" />
						<path d="M-88 52 L0 2 L88 52" fill="none" stroke="#9ed87a" stroke-width=".6" opacity=".24" />
						<path d="M-100 0 L0 38 L100 0 L0 -38 Z" fill="none" stroke="#f3ffe8" stroke-width=".9" opacity=".45" />
						<circle cx="0" cy="0" r="3" fill="#e8ffd4" opacity=".55" />
					</g>
				</g>
			</svg>
		</div>

		<aside class="hero__panel" aria-label="Principais frentes de atendimento da AJN">
			<span class="hero__panel-kicker">Em SST e engenharia</span>
			<strong class="hero__panel-title">Principais frentes de atendimento</strong>
			<ul>
				<li>
					<span class="hero__panel-item-title">Programas e laudos</span>
					<span class="hero__panel-item-detail">PGR, LTCAT e exposição</span>
				</li>
				<li>
					<span class="hero__panel-item-title">Saúde ocupacional</span>
					<span class="hero__panel-item-detail">PCMSO, ASOs e eSocial</span>
				</li>
				<li>
					<span class="hero__panel-item-title">Atividades em campo</span>
					<span class="hero__panel-item-detail">Inspeções e treinamentos</span>
				</li>
			</ul>
		</aside>
	</div>
</section>

---
import { hero } from '../data/home';
---

<section class="hero" style={`--hero-image: url('${hero.image}')`} aria-labelledby="hero-title">
	<div class="site-shell hero__content">
		<p class="hero__eyebrow">Qualidade · Saúde · Segurança · Meio Ambiente</p>
		<h1 id="hero-title" class="hero__title">AJN Consultoria e Engenharia</h1>
		<p>{hero.text}</p>
		<div class="hero__actions">
			<a class="button button--outline" href="/sobre-nos">Conheça a AJN</a>
			<a class="button" href="/servicos">Conheça nossos serviços</a>
		</div>
	</div>
</section>

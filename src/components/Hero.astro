---
import { hero } from '../data/home';
---

<section class="hero" style={`--hero-image: url('${hero.image}')`} aria-labelledby="hero-title">
	<div class="site-shell hero__content">
		<div class="hero__main">
			<p class="hero__eyebrow">{hero.eyebrow}</p>
			<h1 id="hero-title">{hero.title}</h1>
			<p class="hero__lead">{hero.description}</p>
			<div class="hero__actions">
				<a class="button" href="/contato">Solicitar atendimento</a>
				<a class="button button--outline" href="/servicos">Conhecer os serviços</a>
			</div>
		</div>
		<aside class="hero__panel" aria-label="Soluções da AJN">
			<span class="hero__panel-kicker">Serviços da AJN</span>
			<strong class="hero__panel-title">Do PGR à inspeção em campo.</strong>
			<ul>
				<li><span aria-hidden="true">✓</span> PGR, LTCAT e avaliações de exposição</li>
				<li><span aria-hidden="true">✓</span> PCMSO, ASOs e informações para o eSocial</li>
				<li><span aria-hidden="true">✓</span> Inspeções, treinamentos e projetos técnicos</li>
			</ul>
			<a href="/servicos">Ver os serviços da AJN <span aria-hidden="true">↗</span></a>
		</aside>
	</div>
</section>

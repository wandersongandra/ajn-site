---
import { hero } from '../data/home';
---

<section class="hero" style={`--hero-image: url('${hero.image}')`} aria-labelledby="hero-title">
	<div class="site-shell hero__content">
		<div class="hero__main">
			<p class="hero__eyebrow">{hero.eyebrow}</p>
			<h1 id="hero-title">{hero.title}</h1>
			<p class="hero__lead">{hero.description}</p>
			<div class="hero__actions">
				<a class="button" href="/contato">Solicitar atendimento</a>
				<a class="button button--outline" href="/servicos">Conhecer os serviços</a>
			</div>
		</div>

		<aside class="hero__panel" aria-label="Principais frentes de atendimento da AJN">
			<span class="hero__panel-kicker">Em SST e engenharia</span>
			<strong class="hero__panel-title">Principais frentes de atendimento</strong>
			<ul>
				<li>
					<span class="hero__panel-item-title">Programas e laudos</span>
					<span class="hero__panel-item-detail">PGR, LTCAT e avaliações de exposição</span>
				</li>
				<li>
					<span class="hero__panel-item-title">Saúde ocupacional</span>
					<span class="hero__panel-item-detail">PCMSO, ASOs e registros de SST no eSocial</span>
				</li>
				<li>
					<span class="hero__panel-item-title">Atividades em campo</span>
					<span class="hero__panel-item-detail">Inspeções, treinamentos e projetos técnicos</span>
				</li>
			</ul>
		</aside>
	</div>
</section>

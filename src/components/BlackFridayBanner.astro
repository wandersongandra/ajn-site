---
import '../styles/black-friday.css';
import { BLACK_FRIDAY_ACTIVE, blackFriday } from '../data/campaign';
---

{BLACK_FRIDAY_ACTIVE && (
	<div class="bf-banner" id="bf-banner" role="region" aria-label="Black Friday AJN — condições especiais">
		<div class="bf-banner__shapes" aria-hidden="true"></div>
		<div class="site-shell bf-banner__inner">
			<p class="bf-banner__copy">
				<strong class="bf-banner__label">{blackFriday.label}</strong>
				<span class="bf-banner__line">{blackFriday.line}</span>
			</p>
			<a class="bf-banner__cta" href={blackFriday.href} target="_blank" rel="noopener noreferrer">
				{blackFriday.cta}
				<span class="sr-only"> pelo WhatsApp (abre em uma nova aba)</span>
			</a>
		</div>
	</div>
)}

---
import ContentSections from './ContentSections.astro';
import PageShell from './PageShell.astro';
import type { MarketingContent } from '../content/types';
import { Image } from 'astro:assets';
import { getMarketingSeo, getRelatedClusterLinks, getRelatedService, normalizeKeywordTerms } from '../utils/seo';
import { absoluteSiteUrl, serializeJsonLd, siteOrigin } from '../utils/site';

interface Props {
	page: MarketingContent;
}

const { page } = Astro.props;
const seo = getMarketingSeo(page);
const heading = seo.heading;
const relatedService = getRelatedService(page.path);
const clusterLinks = getRelatedClusterLinks(page.path).filter((item) => item.href !== relatedService?.href);
const pageUrl = absoluteSiteUrl(page.path + '/');
const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	'@id': pageUrl + '#service',
	name: heading,
	description: seo.description,
	url: pageUrl,
	provider: {
		'@type': 'Organization',
		'@id': siteOrigin + '/#organization',
		name: 'AJN Consultoria e Engenharia',
	},
	areaServed: [
		{ '@type': 'City', name: 'Belo Horizonte' },
		{ '@type': 'State', name: 'Minas Gerais' },
	],
};
---

<PageShell heading={heading}>
	<div class="detail-layout">
		<div class="detail-layout__main reading-surface">
			<div class="content-gallery">
				{page.images.map((image, index) => (
					<a href={image.src}>
						<Image
							src={image.src}
							alt={image.alt === page.heading ? heading : normalizeKeywordTerms(image.alt)}
							width={900}
							height={600}
							format="webp"
							loading={index === 0 ? 'eager' : 'lazy'}
							fetchpriority={index === 0 ? 'high' : 'auto'}
							sizes="(max-width: 768px) 100vw, 900px"
						/>
					</a>
				))}
			</div>
			<p class="gallery-note">Clique nas imagens para ampliar</p>
			<ContentSections sections={page.sections} formatHeading={normalizeKeywordTerms} />
			<p class="page-cta"><a class="button" href="/contato/">Falar com a AJN</a></p>
		</div>
		<aside class="detail-sidebar" aria-label="Navegação relacionada">
			<p class="detail-sidebar__eyebrow">AJN Consultoria e Engenharia</p>
			<a class="detail-sidebar__cta" href="/contato/">Solicite um orçamento</a>
			<h2>Explore</h2>
			<ul>
				<li><a href="/servicos/">Nossos serviços</a></li>
				{relatedService ? <li><a href={relatedService.href}>{relatedService.label}</a></li> : null}
				{clusterLinks.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
				<li><a href="/sobre-nos/">Sobre a AJN</a></li>
				<li><a href="/blog/">Conteúdo técnico</a></li>
				<li><a href="/mapa-site/">Mapa do site</a></li>
			</ul>
			<a class="detail-sidebar__all" href="/contato/">Entrar em contato →</a>
		</aside>
	</div>
</PageShell>
<script type="application/ld+json" set:html={serializeJsonLd(serviceSchema)} />

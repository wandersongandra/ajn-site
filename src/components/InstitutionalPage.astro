---
import { Image } from 'astro:assets';
import fachada from '../assets/about/fachada.webp';
import institutionalPhoto from '../assets/about/sobre-nos.webp';
import { institutionalPage } from '../content/institutional/sobre-nos';
import { absoluteSiteUrl, serializeJsonLd } from '../utils/site';

const breadcrumbs = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: absoluteSiteUrl('/') },
		{ '@type': 'ListItem', position: 2, name: 'Sobre nós', item: absoluteSiteUrl('/sobre-nos') },
	],
};
---

<div class="about-page" data-about-page>
	<section class="about-page__hero" aria-labelledby="about-title">
		<div class="site-shell">
			<nav class="about-page__breadcrumb" aria-label="Navegação estrutural">
				<a href="/">Início</a><span aria-hidden="true">/</span><span aria-current="page">Sobre nós</span>
			</nav>
			<div class="about-page__hero-grid">
				<div class="about-page__hero-copy" data-about-reveal>
					<p class="about-page__eyebrow">{institutionalPage.eyebrow}</p>
					<h1 id="about-title">{institutionalPage.heading}</h1>
					<p class="about-page__lead">{institutionalPage.lead}</p>
					<a class="about-page__text-link" href="#atuacao">Conheça nossa atuação <span aria-hidden="true">↗</span></a>
				</div>
				<figure class="about-page__hero-media" data-about-reveal>
					<Image src={fachada} alt="" role="presentation" format="webp" quality={84}
						widths={[160, 240, 320, 480, 640]}
						sizes="(max-width: 780px) calc(100vw - 32px), 49vw"
						loading="eager" fetchpriority="high" decoding="async"
					/>
				</figure>
			</div>
		</div>
	</section>

	<section class="about-page__intro" id="atuacao" aria-labelledby="about-intro-title">
		<div class="site-shell about-page__intro-grid">
			<div class="about-page__section-heading" data-about-reveal>
				<p class="about-page__eyebrow">Quem somos</p>
				<h2 id="about-intro-title">{institutionalPage.introTitle}</h2>
			</div>
			<div class="about-page__intro-text" data-about-reveal>
				{institutionalPage.intro.map(paragraph => <p>{paragraph}</p>)}
			</div>
		</div>
	</section>

	<section class="about-page__areas" aria-labelledby="about-areas-title">
		<div class="site-shell">
			<div class="about-page__section-heading" data-about-reveal>
				<p class="about-page__eyebrow">Serviços</p>
				<h2 id="about-areas-title">{institutionalPage.areasTitle}</h2>
			</div>
			<div class="about-page__areas-grid">
				{institutionalPage.areas.map(area => (
					<article class="about-page__area" data-about-reveal>
						<h3>{area.title}</h3>
						<p>{area.text}</p>
					</article>
				))}
			</div>
			<a class="about-page__text-link" href="/servicos">Consultar os serviços <span aria-hidden="true">↗</span></a>
		</div>
	</section>

	<section class="about-page__principles" aria-labelledby="about-principles-title">
		<div class="site-shell about-page__principles-grid">
			<figure class="about-page__principles-media" data-about-reveal>
				<Image src={institutionalPhoto} alt="" role="presentation" format="webp" quality={84}
					widths={[400, 640, 800, 960]}
					sizes="(max-width: 780px) calc(100vw - 32px), 43vw"
					loading="lazy" decoding="async"
				/>
			</figure>
			<div class="about-page__principles-copy">
				<div class="about-page__section-heading" data-about-reveal>
					<p class="about-page__eyebrow">Nossa forma de trabalhar</p>
					<h2 id="about-principles-title">{institutionalPage.principlesTitle}</h2>
				</div>
				<div class="about-page__principles-list">
					{institutionalPage.values.map(value => (
						<section class="about-page__principle" data-about-reveal>
							<h3>{value.heading}</h3>
							<p>{value.text}</p>
						</section>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="about-page__closing" aria-labelledby="about-closing-title">
		<div class="site-shell about-page__closing-inner" data-about-reveal>
			<div>
				<p class="about-page__eyebrow">Contato</p>
				<h2 id="about-closing-title">{institutionalPage.closingTitle}</h2>
				<p>{institutionalPage.closingText}</p>
			</div>
			<a class="about-page__contact-link" href="/contato">Falar com a AJN <span aria-hidden="true">↗</span></a>
		</div>
	</section>
	<script type="application/ld+json" set:html={serializeJsonLd(breadcrumbs)} />
</div>

---
import type { ContentSegment } from '../content/types';

interface Props {
	segments: readonly ContentSegment[];
}

const { segments } = Astro.props;
---

{segments.map((segment) =>
	typeof segment === 'string' ? segment : 'href' in segment ? (
		<a href={segment.href}>{segment.text}</a>
	) : 'bold' in segment ? <strong>{segment.text}</strong> : null
)}

<aside class="promo-card" data-promo-card hidden aria-label="Aviso AJN Consultoria e Engenharia">
	<button class="promo-card__close" type="button" aria-label="Fechar aviso" data-promo-close>×</button>
	<a href="https://web.whatsapp.com/send?phone=5531984734644&text=Ol%C3%A1%21%20Gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20as%20ofertas%20da%20AJN%20Consultoria%20e%20Engenharia" target="_blank" rel="nofollow noopener noreferrer">
		<img src="/images/popup.jpg" alt="Aviso sobre eventos de Saúde e Segurança do Trabalho" width="722" height="722" />
	</a>
</aside>

<script>
	const promo = document.querySelector<HTMLElement>('[data-promo-card]');
	const close = document.querySelector<HTMLButtonElement>('[data-promo-close]');

	if (promo && window.sessionStorage.getItem('ajn-promo-dismissed') !== '1') {
		window.setTimeout(() => {
			promo.hidden = false;
		}, 4500);
	}

	close?.addEventListener('click', () => {
		window.sessionStorage.setItem('ajn-promo-dismissed', '1');
		if (promo) promo.hidden = true;
	});
</script>

---
import { site } from '../data/home';
---
<dialog class="promo-dialog" aria-labelledby="promo-title">
	<div class="promo-dialog__content">
		<button class="promo-dialog__close" type="button" aria-label="Fechar aviso">×</button>
		<a href={site.phoneHref} target="_blank" rel="nofollow noopener noreferrer"><img src="/images/popup.jpg" alt="Aviso sobre eventos de Saúde e Segurança do Trabalho" width="722" height="722" /></a>
		<h2 id="promo-title" class="sr-only">Aviso AJN Consultoria e Engenharia</h2>
	</div>
</dialog>
<script>
	const dialog = document.querySelector<HTMLDialogElement>('.promo-dialog');
	if (dialog && !dialog.open) dialog.showModal();
	document.querySelector<HTMLButtonElement>('.promo-dialog__close')?.addEventListener('click', () => dialog?.close());
</script>
